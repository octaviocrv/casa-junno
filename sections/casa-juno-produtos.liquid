      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espaço abaixo mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
