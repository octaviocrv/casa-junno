      "default": "#F4EEE6"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Cor do fundo do bloco superior",
      "default": "#F8F5EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto principal",
      "default": "#2A1810"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Cor do texto secundário",
      "default": "#6F6258"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor vinho/marrom dos links",
