      "id": "max_width",
      "label": "Largura máxima desktop",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding topo desktop",
      "min": 0,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding baixo desktop",
      "min": 0,
