        </div>
        <div class="cj-pdp__story-image">
          {% if section.settings.story_image != blank %}
            {% assign story_image_alt = section.settings.story_title | default: product.title | escape %}
            {{ section.settings.story_image | image_url: width: 980 | image_tag:
              widths: '360, 520, 720, 980',
              loading: 'lazy',
              alt: story_image_alt
            }}
          {% elsif first_image != blank %}
            {% assign story_first_alt = product.title | escape %}
            {{ first_image | image_url: width: 980 | image_tag:
              widths: '360, 520, 720, 980',
              loading: 'lazy',
