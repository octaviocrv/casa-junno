        padding: 9px 12px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__services {
        gap: 8px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__service {
        min-height: 66px;
        padding: 14px;
      }


      #CasaJunoPdp-{{ section.id }} {
        padding-bottom: {% if section.settings.enable_mobile_sticky %}78px{% else %}0{% endif %};
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__price-row {
        margin-bottom: 22px;
        gap: 9px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__compare {
        font-size: 14px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__tax-note {
        margin-bottom: 22px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__quantity-row {
        grid-template-columns: 1fr;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__qty {
        grid-template-columns: 54px 1fr 54px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__add {
        min-height: 56px;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__editorial-card {
        flex-basis: 68%;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__mobile-sticky {
        {% if section.settings.enable_mobile_sticky %}
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 70;
          display: grid;
          grid-template-columns: 1fr auto;
          gap: 12px;
          align-items: center;
          padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
          background: rgba(255, 253, 250, 0.94);
          border-top: 1px solid rgba(116, 76, 58, 0.14);
          backdrop-filter: blur(14px);
          -webkit-backdrop-filter: blur(14px);
          transform: translateY(110%);
          transition: transform 0.32s ease;
        {% else %}
          display: none;
        {% endif %}
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__mobile-sticky.is-visible {
        transform: translateY(0);
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__mobile-sticky-title {
        min-width: 0;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__mobile-sticky-name {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--cj-pdp-text);
        font-family: var(--cj-pdp-font-heading);
        font-size: 15px;
        line-height: 1.2;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__mobile-sticky-price {
        display: block;
        margin-top: 3px;
        color: var(--cj-pdp-muted);
        font-size: 12px;
        line-height: 1;
      }

      #CasaJunoPdp-{{ section.id }} .cj-pdp__mobile-sticky-btn {
        min-height: 44px;
        padding: 12px 18px;
        border: 1px solid var(--cj-pdp-button-bg);
        background: var(--cj-pdp-button-bg);
        color: var(--cj-pdp-button-text);
        font-family: var(--cj-pdp-font-heading);
        font-size: 12px;
        line-height: 1;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #CasaJunoPdp-{{ section.id }} *,
      #CasaJunoPdp-{{ section.id }} *::before,
      #CasaJunoPdp-{{ section.id }} *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>

  <div class="cj-pdp__shell">
    {% if show_breadcrumb %}
      <nav class="cj-pdp__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Casa Juno</a>
        <span class="cj-pdp__breadcrumb-separator">/</span>
        {% if collection %}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        {% else %}
          <a href="/collections/all">Coleção</a>
        {% endif %}
        <span class="cj-pdp__breadcrumb-separator">/</span>
        <span>{{ product.title }}</span>
      </nav>
    {% endif %}

    <div class="cj-pdp__hero">
      <div class="cj-pdp__media cj-pdp__fade-up">
        <div class="cj-pdp__media-stage" data-cj-main-stage>
          <span class="cj-pdp__media-badge">{{ section.settings.media_badge }}</span>
          <div class="cj-pdp__main-image-wrap">
            {% if first_image != blank %}
              {% assign first_image_alt = first_image.alt | default: product.title | escape %}
              {{ first_image | image_url: width: 1400 | image_tag:
                class: 'cj-pdp__main-image',
                widths: '420, 620, 820, 1000, 1200, 1400',
                loading: 'eager',
                fetchpriority: 'high',
                alt: first_image_alt,
                data-cj-main-image: ''
              }}
            {% else %}
              <div class="cj-pdp__placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <span class="cj-pdp__media-count" data-cj-media-count>1 / {{ product.media.size | default: 1 }}</span>
        </div>

        <div class="cj-pdp__thumb-row" aria-label="Galeria do produto">
          {% if product.media.size > 0 %}
            {% for media in product.media limit: image_limit %}
              {% assign thumb_image = media.preview_image %}
              <button
                type="button"
                class="cj-pdp__thumb {% if forloop.first %}is-active{% endif %}"
                data-cj-thumb
                data-full-image="{{ thumb_image | image_url: width: 1400 }}"
                data-image-alt="{{ thumb_image.alt | default: product.title | escape }}"
                data-index="{{ forloop.index }}"
                aria-label="Ver imagem {{ forloop.index }}"
              >
                {% if thumb_image != blank %}
                  {% assign thumb_alt = thumb_image.alt | default: product.title | escape %}
                  {{ thumb_image | image_url: width: 240 | image_tag:
                    class: 'cj-pdp__thumb-img',
                    widths: '80, 120, 160, 200, 240',
                    loading: 'lazy',
                    alt: thumb_alt
                  }}
                {% else %}
                  <span class="cj-pdp__thumb-placeholder"></span>
                {% endif %}
              </button>
            {% endfor %}
          {% endif %}
        </div>

        {% assign detail_blocks = section.blocks | where: 'type', 'detail_image' %}
        {% assign media_extra_count = 0 %}
        {% for i in (1..4) %}
          {% assign image_key = 'media_extra_image_' | append: i %}
          {% if section.settings[image_key] != blank %}
            {% assign media_extra_count = media_extra_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% assign settings_media_count = media_extra_count %}
        {% if settings_media_count == 0 %}
          {% for block in detail_blocks limit: 4 %}
            {% if block.settings.image != blank %}
              {% assign media_extra_count = media_extra_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if media_extra_count > 0 %}
          <div class="cj-pdp__media-details" aria-label="Imagens abaixo da foto principal">
            {% if section.settings.detail_media_title != blank %}
              <p class="cj-pdp__media-details-title">{{ section.settings.detail_media_title }}</p>
            {% endif %}
            <div class="cj-pdp__media-details-grid" data-count="{{ media_extra_count }}">
              {% for i in (1..4) %}
                {% assign image_key = 'media_extra_image_' | append: i %}
                {% assign caption_key = 'media_extra_caption_' | append: i %}
                {% assign extra_image = section.settings[image_key] %}
                {% assign extra_caption = section.settings[caption_key] %}
                {% if extra_image != blank %}
                  {% assign extra_alt = extra_caption | default: product.title | escape %}
                  <figure class="cj-pdp__media-detail-card">
                    {{ extra_image | image_url: width: 1600 | image_tag:
                      widths: '360, 520, 720, 920, 1200, 1600',
                      loading: 'lazy',
                      alt: extra_alt
                    }}
                    {% if extra_caption != blank %}
                      <figcaption class="cj-pdp__media-detail-caption">{{ extra_caption }}</figcaption>
                    {% endif %}
                  </figure>
                {% endif %}
              {% endfor %}
              {% if settings_media_count == 0 %}
                {% for block in detail_blocks limit: 4 %}
                  {% if block.settings.image != blank %}
                    {% assign block_detail_alt = block.settings.caption | default: product.title | escape %}
                    <figure class="cj-pdp__media-detail-card" {{ block.shopify_attributes }}>
                      {{ block.settings.image | image_url: width: 1600 | image_tag:
                        widths: '360, 520, 720, 920, 1200, 1600',
                        loading: 'lazy',
                        alt: block_detail_alt
                      }}
                      {% if block.settings.caption != blank %}
                        <figcaption class="cj-pdp__media-detail-caption">{{ block.settings.caption }}</figcaption>
                      {% endif %}
                    </figure>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>

      <div class="cj-pdp__info cj-pdp__fade-up">
        <div class="cj-pdp__info-card">
          <div class="cj-pdp__title-row">
            <div>
              <p class="cj-pdp__eyebrow">{{ collection_label }}</p>
              <h1 class="cj-pdp__title">{{ product.title }}</h1>
            </div>
            <button type="button" class="cj-pdp__save" data-cj-save aria-label="Salvar produto">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1Z"></path>
              </svg>
            </button>
          </div>

          <div class="cj-pdp__price-row" aria-live="polite">
            <span class="cj-pdp__price" data-cj-price>{{ current_variant.price | money }}</span>
            <span class="cj-pdp__compare" data-cj-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
              {{ current_variant.compare_at_price | money }}
            </span>
          </div>

          {% if section.settings.tax_note != blank %}
            <span class="cj-pdp__tax-note">{{ section.settings.tax_note }}</span>
          {% endif %}

          <div class="cj-pdp__summary">
            {% if section.settings.short_description != blank %}
              <p class="cj-pdp__summary-text">{{ section.settings.short_description }}</p>
            {% elsif product_description != blank %}
              <p class="cj-pdp__summary-text">{{ product_description | truncate: 220 }}</p>
            {% else %}
              <p class="cj-pdp__summary-text">Uma peça essencial da Casa Juno, criada para unir caimento refinado, toque confortável e elegância discreta no dia a dia.</p>
            {% endif %}
          </div>

          <div class="cj-pdp__meta-list">
            <div class="cj-pdp__meta-line">
              <span class="cj-pdp__meta-label">Material</span>
              <span class="cj-pdp__meta-value">{{ product_material }}</span>
            </div>
            <div class="cj-pdp__meta-line">
              <span class="cj-pdp__meta-label">{{ color_label }}</span>
              <span class="cj-pdp__meta-value" data-cj-color-label>
                {% for option in product.options_with_values %}
                  {% assign option_down = option.name | downcase %}
                  {% if option_down contains 'color' or option_down contains 'cor' %}
                    {{ option.selected_value }}
                  {% endif %}
                {% endfor %}
              </span>
            </div>
            {% if show_vendor and product.vendor != blank %}
              <div class="cj-pdp__meta-line">
                <span class="cj-pdp__meta-label">Marca</span>
                <span class="cj-pdp__meta-value">{{ product.vendor }}</span>
              </div>
            {% endif %}
          </div>

          {% form 'product', product, id: product_form_id, class: 'cj-pdp__form', data-cj-product-form: '' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-cj-variant-id>

            {% unless product.has_only_default_variant %}
              <div class="cj-pdp__variant-area" data-cj-variant-area>
                {% for option in product.options_with_values %}
                  {% assign option_down = option.name | downcase %}
                  {% assign option_index = forloop.index0 %}
                  {% assign option_key = 'option' | append: forloop.index %}
                  {% assign is_color_option = false %}
                  {% assign is_size_option = false %}
                  {% if option_down contains 'color' or option_down contains 'cor' %}
                    {% assign is_color_option = true %}
                  {% endif %}
                  {% if option_down contains 'size' or option_down contains 'tamanho' or option_down contains 'tam' %}
                    {% assign is_size_option = true %}
                  {% endif %}

                  <div class="cj-pdp__option" data-cj-option-group data-option-index="{{ option_index }}">
                    <div class="cj-pdp__option-head">
                      <p class="cj-pdp__option-title">
                        {{ option.name }}:
                        <span class="cj-pdp__option-value" data-cj-option-selected>{{ option.selected_value }}</span>
                      </p>
                      {% if is_size_option %}
                        <button type="button" class="cj-pdp__size-guide-btn" data-cj-size-open>Guia de tamanhos</button>
                      {% endif %}
                    </div>

                    {% if is_size_option %}
                      <div class="cj-pdp__sizes">
                        {% for value in option.values %}
                          <button
                            type="button"
                            class="cj-pdp__size {% if value == option.selected_value %}is-selected{% endif %}"
                            data-cj-option-button
                            data-option-index="{{ option_index }}"
                            data-option-value="{{ value | escape }}"
                          >
                            {{ value }}
                          </button>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="cj-pdp__swatches">
                        {% for value in option.values %}
                          <button
                            type="button"
                            class="cj-pdp__swatch {% if value == option.selected_value %}is-selected{% endif %}"
                            data-cj-option-button
                            data-option-index="{{ option_index }}"
                            data-option-value="{{ value | escape }}"
                          >
                            <span class="cj-pdp__swatch-text">{{ value }}</span>
                          </button>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            <div class="cj-pdp__quantity-row">
              <div class="cj-pdp__qty" aria-label="Quantidade">
                <button type="button" class="cj-pdp__qty-btn" data-cj-qty-minus aria-label="Diminuir quantidade">−</button>
                <input class="cj-pdp__qty-input" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric" data-cj-qty-input>
                <button type="button" class="cj-pdp__qty-btn" data-cj-qty-plus aria-label="Aumentar quantidade">+</button>
              </div>
              <button type="submit" class="cj-pdp__add" data-cj-add {% unless current_variant.available %}disabled{% endunless %}>
                {% if current_variant.available %}
                  {{ section.settings.add_to_cart_text }}
                {% else %}
                  Produto indisponível
                {% endif %}
              </button>
            </div>

            {% if section.settings.show_buy_now %}
              <button type="button" class="cj-pdp__buy-now" data-cj-buy-now {% unless current_variant.available %}disabled{% endunless %}>
                {{ section.settings.buy_now_text }}
              </button>
            {% endif %}

            <p class="cj-pdp__form-message" data-cj-form-message>{{ section.settings.after_button_note }}</p>
          {% endform %}

          {% if section.settings.show_services %}
            <div class="cj-pdp__services">
              <div class="cj-pdp__service">
                <svg class="cj-pdp__service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7h11v10H3z"></path>
                  <path d="M14 10h4l3 3v4h-7z"></path>
                  <circle cx="7" cy="18" r="1.7"></circle>
                  <circle cx="18" cy="18" r="1.7"></circle>
                </svg>
                <p class="cj-pdp__service-text">{{ section.settings.service_1_text }}</p>
              </div>
              <div class="cj-pdp__service">
                <svg class="cj-pdp__service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 8v13H3V8"></path>
                  <path d="M1 3h22v5H1z"></path>
                  <path d="M12 3v18"></path>
                  <path d="M12 3c-1.2-2-5-2-5 1 0 2.5 5 4 5 4s5-1.5 5-4c0-3-3.8-3-5-1z"></path>
                </svg>
                <p class="cj-pdp__service-text">{{ section.settings.service_2_text }}</p>
              </div>
              <div class="cj-pdp__service">
                <svg class="cj-pdp__service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-5"></path>
                </svg>
                <p class="cj-pdp__service-text">{{ section.settings.service_3_text }}</p>
              </div>
            </div>
          {% endif %}

          <div class="cj-pdp__accordion" data-cj-accordion>
            <div class="cj-pdp__accordion-item is-open" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="true" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Sobre o produto</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">
                  {% if section.settings.about_text != blank %}
                    {{ section.settings.about_text }}
                  {% elsif product.description != blank %}
                    {{ product.description }}
                  {% else %}
                    <p>Peça desenvolvida para entregar presença, conforto e acabamento premium sem excesso visual.</p>
