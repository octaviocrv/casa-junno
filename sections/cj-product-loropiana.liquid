                </div>
              </div>
            </div>

            <div class="cj-pdp__accordion-item" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="false" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Detalhes do produto</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">{{ section.settings.details_text }}</div>
              </div>
            </div>

            <div class="cj-pdp__accordion-item" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="false" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Cuidados e manutenção</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">{{ section.settings.care_text }}</div>
