  </div>

  <div class="cj-pdp__size-modal" data-cj-size-modal aria-hidden="true" role="dialog" aria-modal="true" aria-label="Guia de tamanhos Casa Juno">
    <button type="button" class="cj-pdp__size-modal-backdrop" data-cj-size-close aria-label="Fechar guia de tamanhos"></button>
    <div class="cj-pdp__size-modal-panel">
      <button type="button" class="cj-pdp__size-modal-close" data-cj-size-close aria-label="Fechar">×</button>
      <h2 class="cj-pdp__size-modal-title">Guia de tamanhos</h2>
      <p class="cj-pdp__size-modal-copy">Medidas aproximadas para modelagem masculina no Brasil. Para um caimento mais solto, escolha um tamanho acima.</p>
      <div class="cj-pdp__size-table-wrap">
        <table class="cj-pdp__size-table">
          <thead>
            <tr>
              <th>Tamanho</th>
              <th>Peito</th>
              <th>Cintura</th>
              <th>Altura sugerida</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>P</td>
              <td>88-96 cm</td>
              <td>76-84 cm</td>
              <td>1,65-1,75 m</td>
            </tr>
            <tr>
              <td>M</td>
              <td>96-104 cm</td>
              <td>84-92 cm</td>
              <td>1,70-1,82 m</td>
            </tr>
            <tr>
              <td>G</td>
              <td>104-112 cm</td>
              <td>92-100 cm</td>
              <td>1,78-1,88 m</td>
            </tr>
            <tr>
              <td>GG</td>
              <td>112-120 cm</td>
              <td>100-108 cm</td>
              <td>1,84-1,95 m</td>
            </tr>
            <tr>
              <td>XGG</td>
              <td>120-128 cm</td>
              <td>108-116 cm</td>
              <td>1,90 m+</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="cj-pdp__size-note">As medidas podem variar levemente conforme tecido, lavagem e proposta de caimento da peça.</p>
    </div>
  </div>

  <div class="cj-pdp__mobile-sticky" data-cj-mobile-sticky>
    <span class="cj-pdp__mobile-sticky-title">
      <span class="cj-pdp__mobile-sticky-name">{{ product.title }}</span>
      <span class="cj-pdp__mobile-sticky-price" data-cj-mobile-price>{{ current_variant.price | money }}</span>
    </span>
    <button type="button" class="cj-pdp__mobile-sticky-btn" data-cj-mobile-add>Comprar</button>
  </div>

  <script type="application/json" data-cj-variants-json>
    {{ product.variants | json }}
  </script>

  <script>
    (function () {
      var root = document.getElementById('CasaJunoPdp-{{ section.id }}');
      if (!root) return;

      var variantsEl = root.querySelector('[data-cj-variants-json]');
      var variants = [];
      try {
        variants = JSON.parse(variantsEl ? variantsEl.textContent : '[]');
      } catch (error) {
        variants = [];
      }

      var moneyFormat = {{ shop.money_format | json }};
      var selectedOptions = [];
      {% for option in product.options_with_values %}
        selectedOptions.push({{ option.selected_value | json }});
      {% endfor %}

      var mainImage = root.querySelector('[data-cj-main-image]');
      var mediaCount = root.querySelector('[data-cj-media-count]');
      var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-cj-thumb]'));
      var optionButtons = Array.prototype.slice.call(root.querySelectorAll('[data-cj-option-button]'));
      var variantInput = root.querySelector('[data-cj-variant-id]');
      var priceEl = root.querySelector('[data-cj-price]');
      var compareEl = root.querySelector('[data-cj-compare]');
      var mobilePriceEl = root.querySelector('[data-cj-mobile-price]');
      var colorLabel = root.querySelector('[data-cj-color-label]');
      var addBtn = root.querySelector('[data-cj-add]');
      var buyNowBtn = root.querySelector('[data-cj-buy-now]');
      var form = root.querySelector('[data-cj-product-form]');
      var qtyInput = root.querySelector('[data-cj-qty-input]');
      var qtyMinus = root.querySelector('[data-cj-qty-minus]');
      var qtyPlus = root.querySelector('[data-cj-qty-plus]');
      var formMessage = root.querySelector('[data-cj-form-message]');
      var mobileSticky = root.querySelector('[data-cj-mobile-sticky]');
      var mobileAdd = root.querySelector('[data-cj-mobile-add]');
      var saveButton = root.querySelector('[data-cj-save]');
      var sizeModal = root.querySelector('[data-cj-size-modal]');
      var sizeOpenButtons = Array.prototype.slice.call(root.querySelectorAll('[data-cj-size-open]'));
      var sizeCloseButtons = Array.prototype.slice.call(root.querySelectorAll('[data-cj-size-close]'));
      var accordion = root.querySelector('[data-cj-accordion]');
      var fadeItems = Array.prototype.slice.call(root.querySelectorAll('.cj-pdp__fade-up'));
      var sectionProductId = root.getAttribute('data-product-id');

      function formatMoney(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, moneyFormat);
        }
        var value = (Number(cents || 0) / 100).toFixed(2).replace('.', ',');
        return 'R$ ' + value;
      }

      function findVariant() {
        if (!variants.length) return null;
        return variants.find(function (variant) {
          if (!variant.options) return false;
          return variant.options.every(function (value, index) {
            return String(value) === String(selectedOptions[index]);
          });
        }) || null;
      }

      function setButtonAvailability(button, isAvailable, soldOutText, availableText) {
        if (!button) return;
        if (isAvailable) {
          button.removeAttribute('disabled');
          if (availableText) button.textContent = availableText;
        } else {
          button.setAttribute('disabled', 'disabled');
          if (soldOutText) button.textContent = soldOutText;
        }
      }

      function updateLabels() {
        var groups = Array.prototype.slice.call(root.querySelectorAll('[data-cj-option-group]'));
        groups.forEach(function (group) {
          var index = Number(group.getAttribute('data-option-index'));
          var label = group.querySelector('[data-cj-option-selected]');
          if (label) label.textContent = selectedOptions[index] || '';
        });
        if (colorLabel) {
          var colorIndex = -1;
          groups.forEach(function (group) {
            var title = group.querySelector('.cj-pdp__option-title');
            var text = title ? title.textContent.toLowerCase() : '';
            if (text.indexOf('cor') !== -1 || text.indexOf('color') !== -1) {
              colorIndex = Number(group.getAttribute('data-option-index'));
            }
          });
          if (colorIndex >= 0) colorLabel.textContent = selectedOptions[colorIndex] || '';
        }
      }

      function updateOptionButtonStates() {
        optionButtons.forEach(function (button) {
          var index = Number(button.getAttribute('data-option-index'));
          var value = button.getAttribute('data-option-value');
          if (String(selectedOptions[index]) === String(value)) {
            button.classList.add('is-selected');
          } else {
            button.classList.remove('is-selected');
          }
        });
      }

      function updateVariantUI() {
        var variant = findVariant();
        updateLabels();
        updateOptionButtonStates();

        if (!variant) {
          setButtonAvailability(addBtn, false, 'Indisponível', '{{ section.settings.add_to_cart_text | escape }}');
          setButtonAvailability(buyNowBtn, false, '{{ section.settings.buy_now_text | escape }}', '{{ section.settings.buy_now_text | escape }}');
          if (formMessage) {
            formMessage.classList.add('is-error');
            formMessage.textContent = 'Essa combinação de opções não está disponível no momento.';
          }
          return;
        }

        if (variantInput) variantInput.value = variant.id;
        if (priceEl) priceEl.textContent = formatMoney(variant.price);
        if (mobilePriceEl) mobilePriceEl.textContent = formatMoney(variant.price);
        if (compareEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            compareEl.hidden = false;
            compareEl.textContent = formatMoney(variant.compare_at_price);
          } else {
            compareEl.hidden = true;
            compareEl.textContent = '';
          }
        }
        setButtonAvailability(addBtn, variant.available, 'Produto indisponível', '{{ section.settings.add_to_cart_text | escape }}');
        setButtonAvailability(buyNowBtn, variant.available, '{{ section.settings.buy_now_text | escape }}', '{{ section.settings.buy_now_text | escape }}');
        if (formMessage) {
          formMessage.classList.remove('is-error');
          formMessage.textContent = '{{ section.settings.after_button_note | escape }}';
        }

        if (variant.featured_image && mainImage) {
          var variantImage = variant.featured_image.src;
          if (variantImage && mainImage.src.indexOf(variantImage) === -1) {
            changeMainImage(variantImage, variant.featured_image.alt || {{ product.title | json }}, null);
          }
        }
      }

      function changeMainImage(src, alt, index) {
        if (!mainImage || !src) return;
        mainImage.classList.add('is-changing');
        window.setTimeout(function () {
          mainImage.src = src;
          mainImage.srcset = '';
          if (alt) mainImage.alt = alt;
          mainImage.classList.remove('is-changing');
        }, 130);

        if (typeof index !== 'undefined' && index !== null && mediaCount) {
          mediaCount.textContent = index + ' / ' + Math.max(thumbs.length, 1);
        }
      }

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          var src = thumb.getAttribute('data-full-image');
          var alt = thumb.getAttribute('data-image-alt') || {{ product.title | json }};
          var index = thumb.getAttribute('data-index') || '1';
          thumbs.forEach(function (item) { item.classList.remove('is-active'); });
          thumb.classList.add('is-active');
          changeMainImage(src, alt, index);
        });
      });

      optionButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          if (button.classList.contains('is-disabled')) return;
          var index = Number(button.getAttribute('data-option-index'));
          var value = button.getAttribute('data-option-value');
          selectedOptions[index] = value;
          updateVariantUI();
        });
      });

      if (qtyMinus && qtyInput) {
        qtyMinus.addEventListener('click', function () {
          var value = Math.max(1, Number(qtyInput.value || 1) - 1);
          qtyInput.value = value;
        });
      }

      if (qtyPlus && qtyInput) {
        qtyPlus.addEventListener('click', function () {
          var value = Math.max(1, Number(qtyInput.value || 1) + 1);
          qtyInput.value = value;
        });
      }

      if (buyNowBtn && form) {
        buyNowBtn.addEventListener('click', function () {
          var variantId = variantInput ? variantInput.value : '';
          var quantity = qtyInput ? qtyInput.value : '1';
          if (!variantId) return;
          var url = '/cart/' + encodeURIComponent(variantId) + ':' + encodeURIComponent(quantity) + '?checkout';
          window.location.href = url;
        });
      }

      if (mobileAdd && addBtn) {
        mobileAdd.addEventListener('click', function () {
          addBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
          window.setTimeout(function () { addBtn.focus({ preventScroll: true }); }, 380);
        });
      }

      if (saveButton) {
        var saveKey = 'casa-juno-saved-' + sectionProductId;
        try {
          if (window.localStorage.getItem(saveKey) === '1') saveButton.classList.add('is-saved');
        } catch (error) {}
        saveButton.addEventListener('click', function () {
          saveButton.classList.toggle('is-saved');
          try {
            window.localStorage.setItem(saveKey, saveButton.classList.contains('is-saved') ? '1' : '0');
          } catch (error) {}
        });
      }

      function openSizeModal() {
        if (!sizeModal) return;
        sizeModal.classList.add('is-open');
        sizeModal.setAttribute('aria-hidden', 'false');
        document.documentElement.style.overflow = 'hidden';
      }

      function closeSizeModal() {
        if (!sizeModal) return;
        sizeModal.classList.remove('is-open');
        sizeModal.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
      }

      sizeOpenButtons.forEach(function (button) {
        button.addEventListener('click', openSizeModal);
      });

      sizeCloseButtons.forEach(function (button) {
        button.addEventListener('click', closeSizeModal);
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeSizeModal();
      });

      if (accordion) {
        var items = Array.prototype.slice.call(accordion.querySelectorAll('[data-cj-accordion-item]'));
        function setPanelHeight(item, open) {
          var panel = item.querySelector('[data-cj-accordion-panel]');
          var trigger = item.querySelector('[data-cj-accordion-trigger]');
          if (!panel) return;
          if (open) {
            item.classList.add('is-open');
            if (trigger) trigger.setAttribute('aria-expanded', 'true');
            panel.style.height = panel.scrollHeight + 'px';
          } else {
            item.classList.remove('is-open');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            panel.style.height = '0px';
          }
        }
        items.forEach(function (item) {
          var trigger = item.querySelector('[data-cj-accordion-trigger]');
          if (item.classList.contains('is-open')) setPanelHeight(item, true);
          if (!trigger) return;
          trigger.addEventListener('click', function () {
            var isOpen = item.classList.contains('is-open');
            setPanelHeight(item, !isOpen);
          });
        });
        window.addEventListener('resize', function () {
          items.forEach(function (item) {
            if (item.classList.contains('is-open')) setPanelHeight(item, true);
          });
        }, { passive: true });
      }

      if ('IntersectionObserver' in window) {
        var fadeObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              fadeObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        fadeItems.forEach(function (item) { fadeObserver.observe(item); });
      } else {
        fadeItems.forEach(function (item) { item.classList.add('is-visible'); });
      }

      if (mobileSticky) {
        var stickyObserverTarget = addBtn || form;
        if ('IntersectionObserver' in window && stickyObserverTarget) {
          var stickyObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (window.innerWidth > 749) return;
              if (entry.isIntersecting) {
                mobileSticky.classList.remove('is-visible');
              } else {
                mobileSticky.classList.add('is-visible');
              }
            });
          }, { threshold: 0.01 });
          stickyObserver.observe(stickyObserverTarget);
        }
      }

      updateVariantUI();
      window.setTimeout(function () {
        fadeItems.forEach(function (item) { item.classList.add('is-visible'); });
      }, 600);
    })();
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "image": [
        {% for media in product.media limit: image_limit %}
          {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "description": {{ product_description | default: section.settings.short_description | json }},
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ current_variant.price | divided_by: 100.0 | json }},
        "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition"
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "Casa Juno PDP Loro",
  "tag": "section",
  "class": "section-casa-juno-pdp-loro",
  "settings": [
    {
      "type": "header",
      "content": "Estrutura"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Mostrar breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar marca/vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Mostrar botão comprar agora",
      "default": false
    },
    {
