            <div class="cj-pdp__accordion-item" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="false" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Trocas e devoluções</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">{{ section.settings.returns_text }}</div>
              </div>
            </div>

            <div class="cj-pdp__accordion-item" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="false" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Pagamento</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">{{ section.settings.payment_text }}</div>
              </div>
            </div>

            <div class="cj-pdp__accordion-item" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="false" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Serviço e segurança</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">{{ section.settings.security_text }}</div>
              </div>
            </div>

            <div class="cj-pdp__accordion-item" data-cj-accordion-item>
              <button type="button" class="cj-pdp__accordion-trigger" aria-expanded="false" data-cj-accordion-trigger>
                <span class="cj-pdp__accordion-title">Informações de envio</span>
                <span class="cj-pdp__accordion-icon" aria-hidden="true"></span>
              </button>
              <div class="cj-pdp__accordion-panel" data-cj-accordion-panel>
                <div class="cj-pdp__accordion-body">{{ section.settings.shipping_text }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {% if section.settings.show_story_block %}
      <div class="cj-pdp__bottom-story cj-pdp__fade-up">
        <div>
          <p class="cj-pdp__story-kicker">{{ section.settings.story_kicker }}</p>
          <h2 class="cj-pdp__story-title">{{ section.settings.story_title }}</h2>
          <p class="cj-pdp__story-copy">{{ section.settings.story_copy }}</p>
          <div class="cj-pdp__story-list">
            <div class="cj-pdp__story-point">
              <span class="cj-pdp__story-number">01</span>
              <p class="cj-pdp__story-point-text">{{ section.settings.story_point_1 }}</p>
            </div>
            <div class="cj-pdp__story-point">
              <span class="cj-pdp__story-number">02</span>
              <p class="cj-pdp__story-point-text">{{ section.settings.story_point_2 }}</p>
            </div>
            <div class="cj-pdp__story-point">
              <span class="cj-pdp__story-number">03</span>
              <p class="cj-pdp__story-point-text">{{ section.settings.story_point_3 }}</p>
            </div>
            <div class="cj-pdp__story-point">
              <span class="cj-pdp__story-number">04</span>
              <p class="cj-pdp__story-point-text">{{ section.settings.story_point_4 }}</p>
