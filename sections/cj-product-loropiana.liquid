{% comment %}
  Casa Juno Product Page - Loro Piana inspired
  Arquivo novo e isolado.
  Path recomendado: sections/cj-product-loropiana.liquid
  Nao substitui main-product.liquid.
  Nao altera main-product-blocks.liquid.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_media = product.featured_media | default: product.media.first
  assign first_image = first_media.preview_image | default: product.featured_image
  assign product_material = section.settings.material_text | default: product.metafields.custom.material | default: 'Linho premium'
  assign color_label = section.settings.color_label | default: 'Cor'
  assign size_label = section.settings.size_label | default: 'Tamanho'
  assign collection_label = section.settings.collection_label | default: 'Casa Juno'
  assign show_breadcrumb = section.settings.show_breadcrumb
  assign show_vendor = section.settings.show_vendor
  assign product_description = product.description | strip_html
  assign image_limit = section.settings.gallery_limit | default: 7
  assign main_image_size = section.settings.main_image_size | default: 112
  assign main_image_size_mobile = section.settings.main_image_size_mobile | default: 86
  assign media_stage_height_desktop = section.settings.media_stage_height_desktop | default: 760
  assign media_stage_height_mobile = section.settings.media_stage_height_mobile | default: 460
  assign product_form_id = 'CasaJunoProductForm-' | append: section.id
%}

<section
  id="CasaJunoPdp-{{ section.id }}"
  class="cj-pdp"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-cj-pdp
>
  <style>
    #CasaJunoPdp-{{ section.id }} {
      --cj-pdp-bg: {{ section.settings.page_background }};
      --cj-pdp-card: {{ section.settings.card_background }};
      --cj-pdp-image-bg: {{ section.settings.image_background }};
      --cj-pdp-image-fit: {{ section.settings.image_fit }};
      --cj-pdp-main-image-size: {{ main_image_size }}%;
      --cj-pdp-main-image-size-mobile: {{ main_image_size_mobile }}%;
      --cj-pdp-media-stage-height-desktop: {{ media_stage_height_desktop }}px;
      --cj-pdp-media-stage-height-mobile: {{ media_stage_height_mobile }}px;
      --cj-pdp-text: {{ section.settings.text_color }};
      --cj-pdp-muted: {{ section.settings.muted_color }};
      --cj-pdp-accent: {{ section.settings.accent_color }};
      --cj-pdp-border: {{ section.settings.border_color }};
      --cj-pdp-button-bg: {{ section.settings.button_background }};
      --cj-pdp-button-text: {{ section.settings.button_text_color }};
      --cj-pdp-soft-shadow: 0 20px 60px rgba(47, 33, 28, 0.07);
      --cj-pdp-strong-shadow: 0 26px 80px rgba(47, 33, 28, 0.13);
      --cj-pdp-radius: {{ section.settings.card_radius }}px;
      --cj-pdp-max-width: {{ section.settings.max_width }}px;
      --cj-pdp-desktop-gap: {{ section.settings.desktop_gap }}px;
      --cj-pdp-top-padding-desktop: {{ section.settings.padding_top_desktop }}px;
      --cj-pdp-bottom-padding-desktop: {{ section.settings.padding_bottom_desktop }}px;
      --cj-pdp-top-padding-mobile: {{ section.settings.padding_top_mobile }}px;
      --cj-pdp-bottom-padding-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --cj-pdp-font-heading: Georgia, 'Times New Roman', serif;
      --cj-pdp-font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--cj-pdp-bg);
      color: var(--cj-pdp-text);
      font-family: var(--cj-pdp-font-body);
      width: 100%;
      overflow: clip;
    }

    #CasaJunoPdp-{{ section.id }} *,
    #CasaJunoPdp-{{ section.id }} *::before,
    #CasaJunoPdp-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #CasaJunoPdp-{{ section.id }} a {
      color: inherit;
      text-decoration: none;
    }

    #CasaJunoPdp-{{ section.id }} button,
    #CasaJunoPdp-{{ section.id }} input,
    #CasaJunoPdp-{{ section.id }} select,
    #CasaJunoPdp-{{ section.id }} textarea {
      font: inherit;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__shell {
      max-width: var(--cj-pdp-max-width);
      margin: 0 auto;
      padding: var(--cj-pdp-top-padding-desktop) 42px var(--cj-pdp-bottom-padding-desktop);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__breadcrumb {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      margin: 0 0 22px;
      color: var(--cj-pdp-muted);
      font-family: var(--cj-pdp-font-heading);
      font-size: 13px;
      line-height: 1.3;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__breadcrumb a {
      opacity: 0.86;
      transition: opacity 0.24s ease, color 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__breadcrumb a:hover {
      color: var(--cj-pdp-accent);
      opacity: 1;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__breadcrumb-separator {
      opacity: 0.44;
      font-size: 12px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__hero {
      display: grid;
      grid-template-columns: minmax(0, 1.18fr) minmax(360px, 0.82fr);
      gap: var(--cj-pdp-desktop-gap);
      align-items: start;
      min-height: 680px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__media {
      min-width: 0;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__media-stage {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: var(--cj-pdp-media-stage-height-desktop);
    height: var(--cj-pdp-media-stage-height-desktop);
    background: var(--cj-pdp-image-bg);
    border: 1px solid color-mix(in srgb, var(--cj-pdp-border) 85%, transparent);
    display: block;
    padding: 0;
  }

  #CasaJunoPdp-{{ section.id }} .cj-pdp__media-stage::before,
  #CasaJunoPdp-{{ section.id }} .cj-pdp__media-stage::after {
    content: none;
  }

  #CasaJunoPdp-{{ section.id }} .cj-pdp__badge {
    position: absolute;
    z-index: 4;
    top: 26px;
    left: 26px;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    background: color-mix(in srgb, white 90%, transparent);
    color: var(--cj-pdp-accent);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 0 18px 36px rgba(43, 31, 27, 0.08);
  }

  #CasaJunoPdp-{{ section.id }} .cj-pdp__main-image-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cj-pdp-image-bg);
    box-shadow: none;
  }

  #CasaJunoPdp-{{ section.id }} .cj-pdp__main-image {
    width: auto;
    height: auto;
    max-width: var(--cj-pdp-main-image-size);
    max-height: var(--cj-pdp-main-image-size);
    display: block;
    object-fit: var(--cj-pdp-image-fit);
    object-position: center;
    filter: none;
    transition: opacity 0.32s ease, transform 0.32s ease;
  }

  #CasaJunoPdp-{{ section.id }} .cj-pdp__main-image.is-switching {
    opacity: 0;
    transform: scale(0.988);
  }

  #CasaJunoPdp-{{ section.id }} .cj-pdp__placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      min-height: 480px;
      color: rgba(47, 33, 28, 0.26);
      background:
        radial-gradient(circle at 50% 34%, rgba(154, 79, 66, 0.13), transparent 26%),
        linear-gradient(145deg, rgba(255, 255, 255, 0.55), rgba(233, 224, 214, 0.6));
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__placeholder svg {
      width: min(380px, 68%);
      height: auto;
      opacity: 0.48;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__media-badge {
      position: absolute;
      left: 28px;
      top: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 8px 14px 7px;
      background: rgba(255, 253, 250, 0.86);
      border: 1px solid rgba(116, 76, 58, 0.14);
      border-radius: 999px;
      color: var(--cj-pdp-accent);
      font-family: var(--cj-pdp-font-heading);
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      z-index: 2;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__media-count {
      position: absolute;
      right: 28px;
      bottom: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 34px;
      padding: 8px 13px 7px;
      background: rgba(47, 33, 28, 0.74);
      border-radius: 999px;
      color: #fff;
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.08em;
      z-index: 2;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__thumb-row {
      display: grid;
      grid-template-columns: repeat(7, minmax(68px, 1fr));
      gap: 12px;
      margin: 14px 0 0;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__thumb {
      position: relative;
      appearance: none;
      -webkit-appearance: none;
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      padding: 0;
      border: 1px solid transparent;
      border-radius: 0;
      background: var(--cj-pdp-card);
      overflow: hidden;
      cursor: pointer;
      transition: border-color 0.24s ease, transform 0.24s ease, opacity 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__thumb:hover {
      border-color: rgba(116, 76, 58, 0.32);
      transform: translateY(-2px);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__thumb.is-active {
      border-color: var(--cj-pdp-accent);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__thumb-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: var(--cj-pdp-image-fit);
      object-position: center;
      background: var(--cj-pdp-image-bg);
      padding: 8px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__thumb-placeholder {
      display: block;
      width: 100%;
      height: 100%;
      background:
        radial-gradient(circle at 50% 40%, rgba(154, 79, 66, 0.16), transparent 34%),
        linear-gradient(145deg, #f9f5ef, #e9ded4);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__info {
      position: sticky;
      top: calc(var(--m-header-height, 0px) + 22px);
      align-self: start;
      min-width: 0;
      padding: 12px 0 0;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__info-card {
      background: transparent;
      color: var(--cj-pdp-text);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__title-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 20px;
      align-items: start;
      margin: 0 0 24px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__eyebrow {
      margin: 0 0 10px;
      color: var(--cj-pdp-muted);
      font-family: var(--cj-pdp-font-heading);
      font-size: 13px;
      line-height: 1.3;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__title {
      margin: 0;
      color: var(--cj-pdp-text);
      font-family: var(--cj-pdp-font-heading);
      font-size: clamp(34px, 3vw, 56px);
      line-height: 0.98;
      font-weight: 400;
      letter-spacing: -0.035em;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__save {
      position: relative;
      width: 46px;
      height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 1px solid color-mix(in srgb, var(--cj-pdp-border) 72%, transparent);
      border-radius: 999px;
      background: rgba(255, 253, 250, 0.64);
      color: var(--cj-pdp-text);
      cursor: pointer;
      transition: color 0.24s ease, border-color 0.24s ease, background 0.24s ease, transform 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__save:hover {
      color: var(--cj-pdp-accent);
      border-color: color-mix(in srgb, var(--cj-pdp-accent) 46%, transparent);
      background: #fffdfa;
      transform: translateY(-1px);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__save.is-saved {
      color: var(--cj-pdp-accent);
      border-color: color-mix(in srgb, var(--cj-pdp-accent) 50%, transparent);
      background: rgba(154, 79, 66, 0.08);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__save svg {
      width: 22px;
      height: 22px;
      stroke-width: 1.35;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__price-row {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 12px;
      min-height: 34px;
      margin: 0 0 28px;
      font-variant-numeric: lining-nums tabular-nums;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__price {
      color: var(--cj-pdp-text);
      font-family: var(--cj-pdp-font-heading);
      font-size: clamp(25px, 2.15vw, 32px);
      line-height: 1.05;
      font-weight: 400;
      letter-spacing: -0.015em;
      white-space: nowrap;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__compare {
      color: color-mix(in srgb, var(--cj-pdp-muted) 78%, white);
      font-size: 16px;
      line-height: 1.1;
      text-decoration: line-through;
      text-decoration-thickness: 1px;
      opacity: 0.84;
      white-space: nowrap;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__tax-note {
      display: block;
      margin: -14px 0 30px;
      color: var(--cj-pdp-muted);
      font-size: 12px;
      line-height: 1.45;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__summary {
      margin: 0 0 32px;
      padding: 0 0 26px;
      border-bottom: 1px solid color-mix(in srgb, var(--cj-pdp-border) 86%, transparent);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__summary-text {
      max-width: 540px;
      margin: 0;
      color: var(--cj-pdp-muted);
      font-family: var(--cj-pdp-font-heading);
      font-size: 18px;
      line-height: 1.55;
      font-weight: 400;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__meta-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      margin: 0 0 30px;
      border-top: 1px solid color-mix(in srgb, var(--cj-pdp-border) 86%, transparent);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__meta-line {
      display: grid;
      grid-template-columns: 132px 1fr;
      gap: 18px;
      align-items: baseline;
      min-height: 52px;
      padding: 16px 0;
      border-bottom: 1px solid color-mix(in srgb, var(--cj-pdp-border) 86%, transparent);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__meta-label {
      color: var(--cj-pdp-muted);
      font-size: 12px;
      line-height: 1.25;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__meta-value {
      color: var(--cj-pdp-text);
      font-family: var(--cj-pdp-font-heading);
      font-size: 18px;
      line-height: 1.25;
      font-weight: 400;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__variant-area {
      margin: 0 0 28px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__option {
      margin: 0 0 24px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__option-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin: 0 0 13px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__option-title {
      margin: 0;
      color: var(--cj-pdp-muted);
      font-size: 12px;
      line-height: 1.25;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__option-value {
      color: var(--cj-pdp-text);
      font-family: var(--cj-pdp-font-heading);
      font-size: 17px;
      letter-spacing: normal;
      text-transform: none;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__size-guide-btn {
      appearance: none;
      -webkit-appearance: none;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--cj-pdp-accent);
      font-size: 13px;
      line-height: 1.2;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
      transition: color 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__size-guide-btn:hover {
      color: var(--cj-pdp-text);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__swatches {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__swatch {
      position: relative;
      min-width: 52px;
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      border: 1px solid color-mix(in srgb, var(--cj-pdp-border) 88%, transparent);
      background: transparent;
      color: var(--cj-pdp-text);
      cursor: pointer;
      transition: border-color 0.24s ease, color 0.24s ease, background 0.24s ease, transform 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__swatch:hover {
      border-color: color-mix(in srgb, var(--cj-pdp-accent) 44%, transparent);
      transform: translateY(-1px);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__swatch.is-selected {
      border-color: var(--cj-pdp-accent);
      color: var(--cj-pdp-accent);
      background: rgba(154, 79, 66, 0.055);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__swatch.is-disabled {
      opacity: 0.35;
      cursor: not-allowed;
      text-decoration: line-through;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__swatch-text {
      font-family: var(--cj-pdp-font-heading);
      font-size: 15px;
      line-height: 1;
      white-space: nowrap;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__sizes {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__size {
      position: relative;
      appearance: none;
      -webkit-appearance: none;
      min-height: 50px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 8px;
      border: 1px solid color-mix(in srgb, var(--cj-pdp-border) 88%, transparent);
      background: transparent;
      color: var(--cj-pdp-text);
      font-family: var(--cj-pdp-font-heading);
      font-size: 16px;
      line-height: 1;
      cursor: pointer;
      transition: border-color 0.24s ease, background 0.24s ease, color 0.24s ease, transform 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__size:hover {
      border-color: color-mix(in srgb, var(--cj-pdp-accent) 44%, transparent);
      transform: translateY(-1px);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__size.is-selected {
      border-color: var(--cj-pdp-accent);
      color: var(--cj-pdp-accent);
      background: rgba(154, 79, 66, 0.055);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__size.is-disabled {
      opacity: 0.34;
      cursor: not-allowed;
      text-decoration: line-through;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__form {
      margin: 0 0 26px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__quantity-row {
      display: grid;
      grid-template-columns: 130px 1fr;
      gap: 12px;
      margin: 0 0 12px;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__qty {
      display: grid;
      grid-template-columns: 40px 1fr 40px;
      align-items: stretch;
      min-height: 54px;
      border: 1px solid color-mix(in srgb, var(--cj-pdp-border) 88%, transparent);
      background: transparent;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__qty-btn {
      appearance: none;
      -webkit-appearance: none;
      border: 0;
      background: transparent;
      color: var(--cj-pdp-text);
      cursor: pointer;
      font-size: 20px;
      line-height: 1;
      transition: color 0.24s ease, background 0.24s ease;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__qty-btn:hover {
      color: var(--cj-pdp-accent);
      background: rgba(154, 79, 66, 0.045);
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__qty-input {
      width: 100%;
      min-width: 0;
      border: 0 !important;
      outline: 0 !important;
      box-shadow: none !important;
      text-align: center;
      color: var(--cj-pdp-text) !important;
      background: transparent !important;
      font-family: var(--cj-pdp-font-heading) !important;
      font-size: 16px !important;
      -moz-appearance: textfield;
    }

    #CasaJunoPdp-{{ section.id }} .cj-pdp__qty-input::-webkit-outer-spin-button,
    #CasaJunoPdp-{{ section.id }} .cj-pdp__qty-input::-webkit-inner-spin-button {
      -webkit-appearance: none;
