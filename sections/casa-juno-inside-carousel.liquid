{% comment %}
  Section: Casa Juno Inside Carousel
{% endcomment %}

<section
  id="CasaJunoInside-{{ section.id }}"
  class="cj-inside-section"
  style="
    --cj-bg: {{ section.settings.background_color }};
    --cj-text: {{ section.settings.text_color }};
    --cj-muted: {{ section.settings.muted_color }};
    --cj-accent: {{ section.settings.accent_color }};
    --cj-max-width: {{ section.settings.max_width }}px;
    --cj-padding-top: {{ section.settings.padding_top }}px;
    --cj-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="cj-inside-wrap">
    <div class="cj-inside-header">
      <h2>{{ section.settings.heading }}</h2>

      {% if section.blocks.size > 1 %}
        {% assign slides_total = section.blocks.size %}
        {% if slides_total < 10 %}
          {% assign slides_total_label = '0' | append: slides_total %}
        {% else %}
          {% assign slides_total_label = slides_total %}
        {% endif %}

        <div class="cj-inside-controls">
          <button class="cj-inside-arrow cj-inside-prev" type="button" aria-label="Anterior">
            ‹
          </button>

          <span class="cj-inside-count">
            <span class="cj-current">01</span>/<span>{{ slides_total_label }}</span>
          </span>

          <button class="cj-inside-arrow cj-inside-next" type="button" aria-label="Próximo">
            ›
          </button>
        </div>
      {% endif %}
    </div>

    <div class="cj-inside-slider">
      <div class="cj-inside-track">
        {% for block in section.blocks %}
          {% assign card_index_label = forloop.index %}
          {% if forloop.index < 10 %}
            {% assign card_index_label = '0' | append: forloop.index %}
          {% endif %}

          <article class="cj-inside-card{% if block.settings.link != blank %} is-clickable{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="cj-inside-card-link">
            {% else %}
              <div class="cj-inside-card-link">
            {% endif %}

              <div class="cj-inside-image-box">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'cj-inside-image',
                      alt: block.settings.title
                  }}
                {% else %}
                  <div class="cj-inside-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="cj-inside-content">
                <div class="cj-inside-meta">{{ card_index_label }}</div>

                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description }}</p>
                {% endif %}
              </div>

              {% if block.settings.link != blank %}
                <span class="cj-inside-cta" aria-hidden="true">Explorar</span>
              {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  #CasaJunoInside-{{ section.id }} {
    position: relative;
    isolation: isolate;
    background: var(--cj-bg);
    color: var(--cj-text);
    padding-top: var(--cj-padding-top);
    padding-bottom: var(--cj-padding-bottom);
    overflow: hidden;
  }

  #CasaJunoInside-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 45%),
      radial-gradient(circle at 18% 0%, rgba(255, 255, 255, 0.36), rgba(255, 255, 255, 0) 38%);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-wrap {
    position: relative;
    z-index: 1;
    max-width: var(--cj-max-width);
    margin: 0 auto;
    padding: 0 42px;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-header h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(26px, 2.2vw, 34px);
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--cj-text);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid rgba(47, 33, 28, 0.14);
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: var(--cj-text);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-arrow {
    appearance: none;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(47, 33, 28, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: var(--cj-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-arrow:hover {
    color: var(--cj-accent);
    border-color: rgba(154, 79, 69, 0.45);
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-1px) scale(0.98);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-arrow:disabled {
    opacity: 0.35;
    border-color: rgba(47, 33, 28, 0.08);
    background: rgba(255, 255, 255, 0.45);
    cursor: default;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-count {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    color: var(--cj-muted);
    min-width: 58px;
    text-align: center;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-slider {
    overflow: hidden;
    width: 100%;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-track {
    display: flex;
    gap: 28px;
    will-change: transform;
    transition: transform 0.82s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-card {
    flex: 0 0 calc((100% - 84px) / 4);
    min-width: 0;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    padding: 12px;
    border-radius: 14px;
    border: 1px solid rgba(47, 33, 28, 0.12);
    background: rgba(255, 255, 255, 0.68);
    transition:
      transform 0.62s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      box-shadow 0.42s ease;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-card.is-clickable .cj-inside-card-link:hover,
  #CasaJunoInside-{{ section.id }} .cj-inside-card.is-clickable .cj-inside-card-link:focus-visible {
    border-color: rgba(154, 79, 69, 0.42);
    box-shadow: 0 14px 32px rgba(42, 24, 16, 0.1);
    transform: translateY(-3px);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-card.is-clickable .cj-inside-card-link:focus-visible {
    outline: none;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 0.74 / 1;
    overflow: hidden;
    background: #f7f3ee;
    border-radius: 10px;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-image-box::after {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    pointer-events: none;
    z-index: 2;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.8s ease;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-card:hover .cj-inside-image {
    transform: scale(1.04);
    filter: brightness(0.96);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-placeholder {
    width: 100%;
    height: 100%;
    background: #f4eee8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-placeholder svg {
    width: 45%;
    opacity: 0.35;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-content {
    padding-top: 18px;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-meta {
    margin-bottom: 11px;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cj-accent);
    font-variant-numeric: tabular-nums;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-content h3 {
    margin: 0 0 10px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--cj-text);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-content p {
    margin: 0;
    color: var(--cj-muted);
    font-size: 15px;
    line-height: 1.58;
    max-width: 100%;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-cta {
    margin-top: auto;
    padding-top: 18px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cj-accent);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-cta::after {
    content: "→";
    font-size: 13px;
    transform: translateX(0);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #CasaJunoInside-{{ section.id }} .cj-inside-card.is-clickable .cj-inside-card-link:hover .cj-inside-cta::after,
  #CasaJunoInside-{{ section.id }} .cj-inside-card.is-clickable .cj-inside-card-link:focus-visible .cj-inside-cta::after {
    transform: translateX(4px);
  }

  @media screen and (max-width: 989px) {
    #CasaJunoInside-{{ section.id }} .cj-inside-wrap {
      padding: 0 24px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-card {
      flex: 0 0 calc((100% - 28px) / 2);
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-header h2 {
      font-size: 25px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-card-link {
      padding: 10px;
      border-radius: 12px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-content h3 {
      font-size: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    #CasaJunoInside-{{ section.id }} {
      padding-top: calc(var(--cj-padding-top) * 0.72);
      padding-bottom: calc(var(--cj-padding-bottom) * 0.72);
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-wrap {
      padding: 0 18px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 24px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-header h2 {
      font-size: 23px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-controls {
      gap: 8px;
      padding: 4px 8px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-arrow {
      width: 30px;
      height: 30px;
      font-size: 18px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-track {
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      transition: none;
      will-change: auto;
      touch-action: pan-y;
      padding-bottom: 4px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-track::-webkit-scrollbar {
      display: none;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-card {
      flex: 0 0 min(84%, 320px);
      scroll-snap-align: start;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-image-box {
      aspect-ratio: 0.78 / 1;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-content {
      padding-top: 16px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-content h3 {
      font-size: 17px;
      margin-bottom: 8px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-content p {
      font-size: 14px;
      line-height: 1.5;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-cta {
      padding-top: 14px;
      font-size: 10px;
    }
  }

  @media screen and (max-width: 520px) {
    #CasaJunoInside-{{ section.id }} .cj-inside-wrap {
      padding: 0 14px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-header h2 {
      font-size: 21px;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-card {
      flex: 0 0 88%;
    }

    #CasaJunoInside-{{ section.id }} .cj-inside-content p {
      font-size: 13px;
      line-height: 1.45;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('#CasaJunoInside-{{ section.id }}');
    if (!root) return;

    const track = root.querySelector('.cj-inside-track');
    const prev = root.querySelector('.cj-inside-prev');
    const next = root.querySelector('.cj-inside-next');
    const current = root.querySelector('.cj-current');
    const cards = Array.from(root.querySelectorAll('.cj-inside-card'));

    if (!track || !cards.length) return;

    let index = 0;
    const formatSlideNumber = (value) => String(value).padStart(2, '0');
    const isMobileViewport = () => window.innerWidth <= 749;

    function getCardsPerView() {
      if (isMobileViewport()) return 1;
      if (window.innerWidth <= 989) return 2;
      return 4;
    }

    function maxIndex() {
      return Math.max(0, cards.length - getCardsPerView());
    }

    function getGap() {
      const styles = window.getComputedStyle(track);
      return parseFloat(styles.columnGap || styles.gap || 0) || 0;
    }

    function syncControls() {
      const max = maxIndex();

      if (current) current.textContent = formatSlideNumber(index + 1);
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index >= max;
    }

    function update() {
      const max = maxIndex();

      if (index > max) index = max;
      if (index < 0) index = 0;

      if (isMobileViewport()) {
        track.style.transform = '';
        const move = cards[index] ? cards[index].offsetLeft : 0;

        track.scrollTo({
          left: move,
          behavior: 'smooth'
        });
      } else {
        const cardWidth = cards[0].getBoundingClientRect().width;
        const move = index * (cardWidth + getGap());
        track.style.transform = `translate3d(${-move}px, 0, 0)`;
      }

      syncControls();
    }

    if (prev) {
      prev.addEventListener('click', () => {
        index -= 1;
        update();
      });
    }

    if (next) {
      next.addEventListener('click', () => {
        index += 1;
        update();
      });
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        track.style.transform = '';
        update();
      }, 150);
    });

    function syncIndexFromScroll() {
      if (!isMobileViewport()) return;

      const scrollLeft = track.scrollLeft;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, cardIndex) => {
        const distance = Math.abs(card.offsetLeft - scrollLeft);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = cardIndex;
        }
      });

      if (closestIndex !== index) {
        index = Math.max(0, Math.min(closestIndex, maxIndex()));
        syncControls();
      }
    }

    let scrollTicking = false;

    track.addEventListener('scroll', () => {
      if (!isMobileViewport()) return;
      if (scrollTicking) return;

      scrollTicking = true;
      window.requestAnimationFrame(() => {
        scrollTicking = false;
        syncIndexFromScroll();
      });
    }, { passive: true });

    update();
  })();
</script>

