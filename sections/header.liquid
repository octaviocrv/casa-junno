{%- comment -%}
  CASA JUNNO - Header Editorial
  Busca simplificada no desktop: campo fixo e sem painel expansível.
{%- endcomment -%}

{{ 'header.css' | asset_url | stylesheet_tag }}

<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.show_currency_switcher or section.settings.show_country_selector or section.settings.show_language_switcher -%}
  <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  {% if section.settings.logo %}
    {% assign image_size = section.settings.logo.width %}
    "logo": {{ section.settings.logo | image_url: width: image_size | prepend: "https:" | json }},
  {% endif %}
  "url": {{ shop.url | append: page.url | json }}
}
</script>

{% style %}
  :root {
    --logo-width-desktop: {{ section.settings.logo_max_width }}px;
    --logo-width-mobile: {{ section.settings.mobile_logo_max_width }}px;
    --cj-header-bg: {{ section.settings.casa_juno_header_desktop_bg | default: '#ffffff' }};
    --cj-header-text: {{ section.settings.casa_juno_header_text_color | default: '#2f211c' }};
    --cj-header-accent: {{ section.settings.casa_juno_header_accent_color | default: '#9a4f42' }};
    --cj-panel-bg: {{ section.settings.casa_juno_panel_bg | default: '#ffffff' }};
    --cj-panel-card-bg: {{ section.settings.casa_juno_panel_card_bg | default: '#f7f3ee' }};
    --cj-panel-text: {{ section.settings.casa_juno_panel_text_color | default: '#2f211c' }};
    --cj-panel-muted: {{ section.settings.casa_juno_panel_muted_color | default: '#6d625c' }};
    --cj-panel-accent: {{ section.settings.casa_juno_panel_accent_color | default: '#9a4f42' }};
    --cj-panel-accent-rgb: {{ section.settings.casa_juno_panel_accent_color | default: '#9a4f42' | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --cj-backdrop-opacity: {{ section.settings.casa_juno_panel_backdrop_opacity | default: 50 | divided_by: 100.0 }};
    --cj-panel-top: 98px;
  }

  .cj-header-desktop-shell {
    width: 100%;
    background: var(--cj-header-bg);
    color: var(--cj-header-text);
    font-family: Georgia, 'Times New Roman', serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .cj-header-desktop-shell__row--main {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) auto minmax(240px, 1fr);
    align-items: center;
    min-height: 64px;
    padding: 14px 56px 6px;
    gap: 24px;
  }

  .cj-header-desktop-shell__center {
    display: flex;
    justify-content: center;
  }

  .cj-header-logo {
    width: var(--logo-width-desktop);
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
  }

  .cj-header-logo__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cj-header-desktop-shell__left,
  .cj-header-desktop-shell__right {
    display: flex;
    align-items: center;
  }

  .cj-header-desktop-shell__left {
    justify-content: flex-start;
  }

  .cj-header-desktop-shell__right {
    justify-content: flex-end;
    gap: 20px;
  }

  .cj-header-desktop-shell__right > * {
    display: inline-flex;
    align-items: center;
  }

  .cj-header-search-btn,
  .cj-header-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    text-decoration: none;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cj-header-action:hover,
  .cj-header-search-btn:hover {
    opacity: 0.55;
    transform: translateY(-1px);
  }

  .cj-header-desktop-shell__row--nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 8px 56px 12px;
  }

  .cj-header-nav-link {
    position: relative;
    color: rgba(47, 33, 28, 0.85);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    padding-bottom: 4px;
    transition: color 0.4s ease;
    background: none;
    border: none;
    cursor: pointer;
  }

  .cj-header-nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    right: 50%;
    height: 1px;
    background: var(--cj-header-text);
    opacity: 0.3;
    transition: left 0.6s cubic-bezier(0.16, 1, 0.3, 1), right 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cj-header-nav-link:hover,
  .cj-header-nav-link.is-active {
    color: var(--cj-header-text);
  }

  .cj-header-nav-link:hover::after,
  .cj-header-nav-link.is-active::after {
    left: 0;
    right: 0;
  }

  .cj-header-backdrop {
    position: fixed;
    top: var(--cj-panel-top);
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(20, 10, 5, var(--cj-backdrop-opacity));
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    z-index: 87;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.6s;
  }

  .cj-header-backdrop:not([hidden]) {
    opacity: 1;
    visibility: visible;
  }

  .search-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 34px;
    min-height: 52px;
    overflow: hidden;
    transition: width 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-container[data-search-open="true"] {
    width: clamp(220px, 24vw, 340px);
  }

  .search-trigger {
    position: absolute;
    left: 0;
    top: 50%;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    padding: 0;
    background: transparent;
    color: #111111;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-trigger:hover {
    opacity: 0.65;
  }

  .search-container[data-search-open="true"] .search-trigger {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%) scale(0.95);
  }

  .search-form-wrap {
    width: 0;
    max-width: none;
    padding: 0;
    position: relative;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transform: translateX(-8px);
    transition: width 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-container[data-search-open="true"] .search-form-wrap {
    width: 100%;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

 .search-form-field {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;

  padding: 0 48px 0 18px;
  min-height: 52px;

  background: #ffffff;
  border: 1px solid rgba(47, 33, 28, 0.14);
  border-radius: 12px;

  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);

  transition:
    border-color .28s ease,
    background-color .28s ease;

  margin: 0;
}

.search-form-field:hover {
  border-color: rgba(var(--cj-panel-accent-rgb), 0.28);
}

.search-form-field:focus-within {
  border-color: var(--cj-panel-accent);
  box-shadow: none;
}


  .search-input {
    width: 100%;
    border: none;
    background: transparent;
    box-shadow: none;
    padding: 10px 0;
    font-family: inherit;
    font-size: 14px;
    color: var(--cj-header-text);
    outline: none;
    line-height: 1.3;
    caret-color: var(--cj-panel-accent);
    appearance: none;
    border-radius: 0;
  }

  .search-input::placeholder {
    color: var(--cj-panel-muted);
    opacity: 0.8;
    font-style: normal;
  }

  .search-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-submit-btn {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--cj-header-text);
    z-index: 2;
  }

  .search-empty-btn {
    position: absolute;
    right: 32px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--cj-panel-muted);
    z-index: 2;
  }

  .search-btn:hover {
    opacity: 0.5;
  }

  .search-suggestions {
    display: none !important;
  }

  .cj-header-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 1023px) {
    .cj-header-desktop-shell { display: none; }
  }
{% endstyle %}

<cj-header data-section-id="{{ section.id }}">
  <m-header class="m-header m:block" data-sticky="{{ section.settings.header_sticky }}">
    {% render 'header__topbar', header: section %}

    <div class="m-header__wrapper">
      <header class="m-header__mobile container-fluid m:flex m:items-center">
        <span class="m-menu-button m:flex m:flex-1 m:w-3/12">
          <div class="m-hamburger-box"><div class="m-hamburger-box__inner"></div></div>
        </span>

        <div class="m-logo m-logo--mobile m:w-6/12 m:justify-center">
          <a href="{{ routes.root_url }}" class="m-logo__image">
            <span class="cj-header-logo__text">{{ section.settings.logo_text | default: shop.name }}</span>
          </a>
        </div>

        <div class="m-header__mobile-right m:w-3/12 m:flex m:justify-end">
          {% render 'cart' %}
        </div>

        <nav class="cj-mobile-nav w-full">
          <a class="cj-header-nav-link" href="{{ routes.root_url }}">Home</a>
          <a class="cj-header-nav-link" href="/collections/all">Shop</a>
          <a class="cj-header-nav-link" href="/blogs/journal">Journal</a>
        </nav>
      </header>

      <header class="m-header__desktop">
        <div class="cj-header-desktop-shell">
          <div class="cj-header-desktop-shell__row cj-header-desktop-shell__row--main">
            <div class="cj-header-desktop-shell__left">
              <div class="js-search-container search-container" data-block-id="utilities" data-block-type="header-utilities">
                <button class="js-search-trigger search-trigger" type="button" aria-label="Abrir busca" aria-expanded="false">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20L16.65 16.65"></path>
                  </svg>
                </button>

                <div class="search-form-wrap" aria-hidden="true">
                  <form class="js-search-form search-form" action="{{ routes.search_url }}" method="get" role="search">
                    <div class="search-form-field form-group">
                      <input class="js-search-input form-control search-input input_class" autocomplete="off" type="search" name="q" placeholder="Buscar" aria-label="Buscar">
                      <input type="hidden" name="type" value="product">
                      <button type="submit" class="js-search-input-submit search-btn search-submit-btn" value="Buscar" aria-label="Buscar">
                        <svg class="icon-inline" style="width: 16px; height: 16px;">
                          <use xlink:href="#search"></use>
                        </svg>
                      </button>
                      <button type="button" class="js-empty-search search-btn search-empty-btn" aria-label="Limpar busca" style="display: none;">
                        <svg class="icon-inline"><use xlink:href="#times"></use></svg>
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <div class="cj-header-desktop-shell__center">
              <a href="{{ routes.root_url }}" class="cj-header-logo">
                {% if section.settings.logo != blank %}
                  {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'cj-header-logo__img', loading: 'eager', alt: shop.name }}
                {% else %}
                  <span class="cj-header-logo__text">{{ section.settings.logo_text | default: shop.name }}</span>
                {% endif %}
              </a>
            </div>

            <div class="cj-header-desktop-shell__right">
              <a class="cj-header-action" href="{{ routes.account_url }}" aria-label="Minha Conta">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                  <path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="7" r="4"/>
                </svg>
              </a>
              {% render 'cart' %}
            </div>
          </div>

          <nav class="cj-header-desktop-shell__row cj-header-desktop-shell__row--nav" aria-label="Menu Principal">
            <a class="cj-header-nav-link" href="{{ routes.root_url }}">Home</a>
            <button class="cj-header-nav-link" type="button" data-action="toggle-men">Shop</button>
            <a class="cj-header-nav-link is-active" href="/blogs/journal">Journal</a>
            <a class="cj-header-nav-link" href="/pages/society">Society</a>
            <a class="cj-header-nav-link" href="/pages/concierge">Concierge</a>
          </nav>
        </div>
      </header>
    </div>

    <div class="cj-header-backdrop" data-element="backdrop" hidden></div>

    <section class="cj-men-panel" data-element="men-panel" role="dialog" aria-modal="true" aria-label="Categorias Masculinas">
      <button class="cj-panel-close" type="button" data-action="close-panels" aria-label="Fechar">×</button>
      <div class="cj-men-panel__inner p-12 grid grid-cols-2 gap-8">
        <nav class="cj-men-panel__nav flex flex-col gap-4">
          <a href="/collections/camisas" class="text-xl font-serif">Camisas de Linho <span>›</span></a>
          <a href="/collections/tricot" class="text-xl font-serif">Tricot & Cashmere <span>›</span></a>
          <a href="/collections/alfaiataria" class="text-xl font-serif">Alfaiataria <span>›</span></a>
        </nav>
      </div>
    </section>
  </m-header>
</cj-header>

<script>
  if (!customElements.get('cj-header')) {
    customElements.define('cj-header', class CJHeader extends HTMLElement {
      connectedCallback() {
        this.backdrop = this.querySelector('[data-element="backdrop"]');
        this.searchContainer = this.querySelector('.js-search-container');
        this.searchTrigger = this.querySelector('.js-search-trigger');
        this.searchFormWrap = this.querySelector('.search-form-wrap');
        this.searchInput = this.querySelector('.js-search-input');
        this.searchSubmitBtn = this.querySelector('.js-search-input-submit');
        this.emptyBtn = this.querySelector('.js-empty-search');
        this.menPanel = this.querySelector('[data-element="men-panel"]');

        this.addEventListener('click', (e) => {
          const searchTrigger = e.target.closest('.js-search-trigger');
          if (searchTrigger) {
            this.toggleSearch();
            return;
          }

          const target = e.target.closest('[data-action]');
          if (target) {
            const action = target.dataset.action;
            if (action === 'toggle-men') this.togglePanel(this.menPanel);
            if (action === 'close-panels') this.closeAll();
          }
        });

        this.searchContainer?.setAttribute('data-search-open', 'false');
        this.searchFormWrap?.setAttribute('aria-hidden', 'true');
        this.searchTrigger?.setAttribute('aria-expanded', 'false');
        if (this.searchInput) this.searchInput.disabled = true;
        if (this.searchSubmitBtn) this.searchSubmitBtn.disabled = true;

        document.addEventListener('click', (e) => {
          if (this.searchContainer && !this.searchContainer.contains(e.target)) {
            this.closeSearch();
          }
        });

        if (this.backdrop) {
          this.backdrop.addEventListener('click', () => this.closeAll());
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') this.closeAll();
        });

        if (this.searchInput && this.emptyBtn) {
          this.searchInput.addEventListener('input', () => {
            this.emptyBtn.style.display = this.searchInput.value.trim() ? 'flex' : 'none';
          });

          this.emptyBtn.addEventListener('click', () => {
            this.searchInput.value = '';
            this.searchInput.focus();
            this.emptyBtn.style.display = 'none';
          });
        }
      }

      toggleSearch() {
        const isOpen = this.searchContainer?.getAttribute('data-search-open') === 'true';
        if (isOpen) {
          this.closeSearch();
        } else {
          this.openSearch();
        }
      }

      openSearch() {
        if (!this.searchContainer) return;
        this.searchContainer.setAttribute('data-search-open', 'true');
        this.searchFormWrap?.setAttribute('aria-hidden', 'false');
        this.searchTrigger?.setAttribute('aria-expanded', 'true');

        if (this.searchInput) {
          this.searchInput.disabled = false;
          setTimeout(() => this.searchInput.focus(), 120);
        }
        if (this.searchSubmitBtn) this.searchSubmitBtn.disabled = false;
      }

      closeSearch() {
        this.searchContainer?.setAttribute('data-search-open', 'false');
        this.searchFormWrap?.setAttribute('aria-hidden', 'true');
        this.searchTrigger?.setAttribute('aria-expanded', 'false');

        if (this.searchInput) {
          this.searchInput.disabled = true;
          this.searchInput.blur();
        }
        if (this.searchSubmitBtn) this.searchSubmitBtn.disabled = true;
        if (this.emptyBtn) this.emptyBtn.style.display = 'none';
      }

      togglePanel(panelToOpen) {
        if (!panelToOpen) return;
        const isOpen = panelToOpen.getAttribute('data-panel-open') === 'true';
        this.closeAll();
        if (!isOpen) {
          panelToOpen.setAttribute('data-panel-open', 'true');
          this.backdrop.removeAttribute('hidden');
          document.body.style.overflow = 'hidden';
        }
      }

      closeAll() {
        this.closeSearch();
        this.menPanel?.removeAttribute('data-panel-open');
        if (this.backdrop) this.backdrop.setAttribute('hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  }
</script>

{% schema %}
{
  "name": "Header Editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo da Marca"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texto do Logo",
      "default": "CASA JUNNO"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "min": 100,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Largura Logo Desktop",
      "default": 160
    }
  ]
}
{% endschema %}