{% comment %}
  Casa Juno Serviços — Vitrine Sensorial (Estilo de vida & luxo discreto)
  Conceito: Tela dividida interativa. Fotos reais substituem ícones.
{% endcomment %}

<section id="cj-sensory-services-{{ section.id }}" class="cj-sensory-section">
  <div class="cj-sensory-container">
    
    {% if section.settings.kicker != blank or section.settings.heading != blank %}
      <div class="cj-sensory-header">
        {% if section.settings.kicker != blank %}
          <span class="cj-sensory-kicker">{{ section.settings.kicker }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="cj-sensory-heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="cj-sensory-grid">
      
      <!-- LADO ESQUERDO: Mídia (Imagens Fotográficas) -->
      <div class="cj-sensory-media">
        <div class="cj-sensory-media-inner">
          {% for block in section.blocks %}
            <div class="cj-sensory-image-wrapper {% if forloop.first %}is-active{% endif %}" data-media-index="{{ forloop.index0 }}">
              {% assign asset_image_name = block.settings.asset_image | strip %}
              {% if asset_image_name != blank %}
                <img
                  src="{{ asset_image_name | asset_url }}"
                  loading="lazy"
                  class="cj-sensory-img"
                  alt="{{ block.settings.title | escape }}"
                >
              {% elsif block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: 
                  loading: 'lazy', 
                  class: 'cj-sensory-img',
                  alt: block.settings.title | escape 
                }}
              {% else %}
                <!-- Espaço reservado elegante caso não haja imagem -->
                <div class="cj-sensory-placeholder">
                  <span>Adicione uma foto no editor</span>
                </div>
              {% endif %}
              <div class="cj-sensory-overlay"></div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- LADO DIREITO: Menu Tipográfico -->
      <div class="cj-sensory-content">
        <div class="cj-sensory-list">
          {% for block in section.blocks %}
            <div class="cj-sensory-item {% if forloop.first %}is-active{% endif %}" data-item-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              
              <div class="cj-sensory-item-number">0{{ forloop.index }}</div>
              
              <div class="cj-sensory-item-body">
                <h3 class="cj-sensory-item-title">{{ block.settings.title }}</h3>
                
                <div class="cj-sensory-item-desc-wrapper">
                  <p class="cj-sensory-item-text">{{ block.settings.text }}</p>
                  
                  {% if block.settings.link_label != blank and block.settings.link_url != blank %}
                    <a href="{{ block.settings.link_url }}" class="cj-sensory-link">
                      {{ block.settings.link_label }}
                    </a>
                  {% endif %}
                </div>
              </div>

            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #cj-sensory-services-{{ section.id }} {
    --bg-color: {{ section.settings.background_color }};
    --text-main: {{ section.settings.text_color }};
    --text-muted: {{ section.settings.secondary_text_color }};
    --accent: {{ section.settings.accent_color }};
    --line-color: rgba(38, 33, 29, 0.12); /* Linha muito sutil */
    
    background-color: var(--bg-color);
    color: var(--text-main);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    font-family: var(--font-body-family), "Helvetica Neue", sans-serif;
  }

  #cj-sensory-services-{{ section.id }} * {
    box-sizing: border-box;
  }

  .cj-sensory-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.side_padding_desktop }}px;
  }

  /* Cabeçalho */
  .cj-sensory-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .cj-sensory-kicker {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .cj-sensory-heading {
    margin: 0;
    font-family: var(--font-heading-family), "Georgia", "Times New Roman", serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-main);
  }

  /* Grid Principal */
  .cj-sensory-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Lado Esquerdo: Imagens */
  .cj-sensory-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .cj-sensory-media-inner {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cj-sensory-image-wrapper {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease, visibility 0.8s ease;
    z-index: 1;
  }

  .cj-sensory-image-wrapper.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .cj-sensory-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    transition: transform 1.2s cubic-bezier(0.2, 1, 0.2, 1);
    will-change: transform;
  }

  .cj-sensory-image-wrapper.is-active .cj-sensory-img {
    transform: scale(1);
  }

  .cj-sensory-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.03); /* Filtro luxuoso mínimo */
    pointer-events: none;
  }

  .cj-sensory-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgba(38, 33, 29, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  /* Lado Direito: Textos */
  .cj-sensory-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .cj-sensory-list {
    display: flex;
    flex-direction: column;
  }

  .cj-sensory-item {
    display: flex;
    padding: 40px 0;
    border-bottom: 1px solid var(--line-color);
    cursor: pointer;
    transition: padding-left 0.4s cubic-bezier(0.2, 1, 0.2, 1);
  }

  .cj-sensory-item:first-child {
    border-top: 1px solid var(--line-color);
  }

  .cj-sensory-item-number {
    font-family: var(--font-heading-family), "Georgia", serif;
    font-size: 18px;
    font-style: italic;
    color: var(--text-muted);
    margin-right: 32px;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .cj-sensory-item-body {
    flex: 1;
  }

  .cj-sensory-item-title {
    margin: 0 0 8px 0;
    font-family: var(--font-heading-family), "Georgia", serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400;
    color: var(--text-muted);
    transition: color 0.4s ease;
  }

  .cj-sensory-item-desc-wrapper {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.5s cubic-bezier(0.2, 1, 0.2, 1);
  }

  .cj-sensory-item-text {
    margin: 0 0 20px 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 90%;
  }

  .cj-sensory-link {
    display: inline-block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 4px;
    transition: border-color 0.3s ease;
  }

  .cj-sensory-link:hover {
    border-color: var(--accent);
  }

  /* Estados Ativos / Hover */
  .cj-sensory-item.is-active .cj-sensory-item-number {
    opacity: 1;
    color: var(--text-main);
  }
  
  .cj-sensory-item.is-active .cj-sensory-item-title {
    color: var(--text-main);
  }

  .cj-sensory-item.is-active .cj-sensory-item-desc-wrapper {
    max-height: 200px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 16px;
  }

  @media (hover: hover) {
    .cj-sensory-item:hover .cj-sensory-item-title {
      color: var(--text-main);
    }
    .cj-sensory-item:hover {
      padding-left: 12px;
    }
  }

  /* Responsivo para celular */
  @media screen and (max-width: 989px) {
    #cj-sensory-services-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    .cj-sensory-container {
      padding: 0 {{ section.settings.side_padding_mobile }}px;
    }

    .cj-sensory-header {
      margin-bottom: 40px;
    }

    .cj-sensory-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* No celular, as imagens ficam em linha dentro de cada item do acordeão */
    .cj-sensory-media {
      display: none; /* Esconde a mídia da esquerda */
    }

    .cj-sensory-item {
      flex-direction: column;
      padding: 32px 0;
    }
    
    .cj-sensory-item:hover {
      padding-left: 0; /* Remove efeito ao passar o mouse no celular */
    }

    .cj-sensory-item-number {
      margin-bottom: 12px;
    }

    .cj-sensory-item-title {
      font-size: 24px;
    }

    .cj-sensory-item-desc-wrapper {
      max-height: none;
      opacity: 1;
      transform: none;
      margin-top: 16px;
      display: none; /* Esconde por padrão no celular */
    }

    .cj-sensory-item.is-active .cj-sensory-item-desc-wrapper {
      display: block; /* Revela quando ativo */
    }

    /* Injeta a imagem correspondente no celular dinamicamente via CSS e DOM */
  }

  @media (prefers-reduced-motion: reduce) {
    .cj-sensory-img,
    .cj-sensory-item-desc-wrapper,
    .cj-sensory-image-wrapper {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = 'cj-sensory-services-{{ section.id }}';
    const section = document.getElementById(sectionId);
    if (!section) return;

    const items = section.querySelectorAll('.cj-sensory-item');
    const images = section.querySelectorAll('.cj-sensory-image-wrapper');

    // Se estiver em tela grande, aciona o efeito visual ao passar o mouse
    if (window.innerWidth > 989) {
      items.forEach((item) => {
        item.addEventListener('mouseenter', function() {
          const targetIndex = this.getAttribute('data-item-index');

          // Limpa todos
          items.forEach(el => el.classList.remove('is-active'));
          images.forEach(el => el.classList.remove('is-active'));

          // Ativa o atual
          this.classList.add('is-active');
          const targetImage = section.querySelector(`.cj-sensory-image-wrapper[data-media-index="${targetIndex}"]`);
          if (targetImage) {
            targetImage.classList.add('is-active');
          }
        });
      });
    } else {
      // Se estiver no celular, funciona como acordeão ao clicar
      items.forEach((item) => {
        item.addEventListener('click', function() {
          if (this.classList.contains('is-active')) return; // Já está aberto

          items.forEach(el => el.classList.remove('is-active'));
          this.classList.add('is-active');
        });
      });
    }
  });
</script>

