{% comment %}
  Casa Juno Serviços — versão PT com assets
  Estilo Loro Piana “À sua disposição”.

  O que foi ajustado:
  - Textos em português.
  - CTA “Descubra mais”.
  - 1º card usa asset: casa-juno-servico-motinha.png
  - 2º card usa asset: casa-juno-servico-caixinha.png
  - 3º card fica com fallback SVG até você enviar a imagem final.
{% endcomment %}

<section id="casa-juno-services-{{ section.id }}" class="cj-services-section">
  <div class="cj-services-container">
    {% assign section_heading = section.settings.heading %}
    {% if section_heading == 'At your service' %}
      {% assign section_heading = 'À sua disposição' %}
    {% endif %}

    {% if section_heading != blank %}
      <h2 class="cj-services-heading">{{ section_heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="cj-services-grid">
        {% for block in section.blocks %}
          {% assign service_title = block.settings.title %}
          {% case service_title %}
            {% when 'Free Shipping' %}
              {% assign service_title = 'Entrega grátis' %}
            {% when 'Free Returns and Exchange' %}
              {% assign service_title = 'Trocas e devoluções grátis' %}
            {% when 'Book a Private Appointment in Store' %}
              {% assign service_title = 'Atendimento personalizado' %}
          {% endcase %}

          {% assign service_cta = block.settings.link_label %}
          {% if service_cta == 'Discover More' %}
            {% assign service_cta = 'Descubra mais' %}
          {% endif %}

          <div class="cj-service-card" {{ block.shopify_attributes }}>
            <div class="cj-service-visual">
              {% if block.settings.icon_image != blank %}
                <img
                  src="{{ block.settings.icon_image | image_url: width: 900 }}"
                  alt="{{ service_title | escape }}"
                  class="cj-service-icon"
                  loading="lazy"
                  onerror="this.style.display='none';"
                  width="560"
                  height="420"
                >
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}
                    <img
                      src="{{ 'casa-juno-servico-motinha.png' | asset_url }}"
                      alt="{{ service_title | escape }}"
                      class="cj-service-icon cj-service-icon--asset cj-service-icon--scooter"
                      loading="lazy"
                      onerror="this.style.display='none';"
                    >
                  {% when 2 %}
                    <img
                      src="{{ 'casa-juno-servico-caixinha.png' | asset_url }}"
                      alt="{{ service_title | escape }}"
                      class="cj-service-icon cj-service-icon--asset cj-service-icon--box"
                      loading="lazy"
                      onerror="this.style.display='none';"
                    >
                  {% else %}
                    <img
                      src="{{ 'casa-juno-servico-agendamento.png' | asset_url }}"
                      alt="{{ service_title | escape }}"
                      class="cj-service-icon cj-service-icon--asset cj-service-icon--appointment"
                      loading="lazy"
                      onerror="this.style.display='none';"
                    >
                {% endcase %}
              {% endif %}
            </div>

            {% if service_title != blank %}
              <div class="cj-service-title">{{ service_title }}</div>
            {% endif %}

            {% if service_cta != blank %}
              {% if block.settings.link_url != blank %}
                <a href="{{ block.settings.link_url }}" class="cj-service-cta">– {{ service_cta }} –</a>
              {% else %}
                <div class="cj-service-cta">– {{ service_cta }} –</div>
              {% endif %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #casa-juno-services-{{ section.id }} {
    --cj-services-bg: {{ section.settings.background_color }};
    --cj-services-text: {{ section.settings.text_color }};
    --cj-services-muted: {{ section.settings.secondary_text_color }};
    --cj-services-accent: {{ section.settings.accent_color }};
    --cj-services-divider: {{ section.settings.divider_color }};
    background: var(--cj-services-bg);
    color: var(--cj-services-text);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    font-family: var(--font-body-family), "Times New Roman", serif;
  }

  #casa-juno-services-{{ section.id }} * {
    box-sizing: border-box;
  }

  #casa-juno-services-{{ section.id }} .cj-services-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding_desktop }}px;
    padding-right: {{ section.settings.side_padding_desktop }}px;
  }

  #casa-juno-services-{{ section.id }} .cj-services-heading {
    margin: 0 0 {{ section.settings.heading_gap_desktop }}px;
    text-align: center;
    font-family: var(--font-heading-family), "Times New Roman", serif;
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.015em;
    color: var(--cj-services-text);
  }

  #casa-juno-services-{{ section.id }} .cj-services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
  }

  #casa-juno-services-{{ section.id }} .cj-service-card {
    min-height: {{ section.settings.card_min_height_desktop }}px;
    padding: 0 {{ section.settings.card_side_padding_desktop }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    position: relative;
  }

  #casa-juno-services-{{ section.id }} .cj-service-card:not(:last-child)::after {
    content: "";
    position: absolute;
    top: {{ section.settings.divider_top_desktop }}px;
    right: 0;
    width: 1px;
    height: {{ section.settings.divider_height_desktop }}px;
    background: var(--cj-services-divider);
    opacity: {{ section.settings.divider_opacity | divided_by: 100.0 }};
  }

  #casa-juno-services-{{ section.id }} .cj-service-visual {
    height: calc({{ section.settings.visual_height_desktop }}px * 1.65);
    margin-bottom: {{ section.settings.visual_gap_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #casa-juno-services-{{ section.id }} .cj-service-icon {
    max-width: {{ section.settings.icon_width }}px;
    max-height: {{ section.settings.icon_height }}px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(100%) contrast(0.95);
    opacity: 0.9;
  }

  #casa-juno-services-{{ section.id }} .cj-service-icon--asset {
    filter: grayscale(100%) contrast(1.04) brightness(1.02);
    opacity: 0.92;
  }

  #casa-juno-services-{{ section.id }} .cj-service-icon--scooter {
    width: min(280px, 100%);
    max-width: 280px;
    max-height: 190px;
  }

  #casa-juno-services-{{ section.id }} .cj-service-icon--box {
    width: min(270px, 100%);
    max-width: 270px;
    max-height: 190px;
  }

  #casa-juno-services-{{ section.id }} .cj-service-icon--appointment {
    max-width: calc({{ section.settings.icon_width }}px + 64px);
    max-height: calc({{ section.settings.icon_height }}px + 38px);
  }

  #casa-juno-services-{{ section.id }} .cj-service-placeholder {
    width: {{ section.settings.icon_width }}px;
    height: {{ section.settings.icon_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(25, 23, 21, 0.68);
    opacity: 0.86;
  }

  #casa-juno-services-{{ section.id }} .cj-service-placeholder svg {
    width: 100%;
    height: 100%;
  }

  #casa-juno-services-{{ section.id }} .cj-service-title {
    max-width: {{ section.settings.title_max_width }}px;
    margin: 0 auto;
    font-family: var(--font-body-family), "Times New Roman", serif;
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: {{ section.settings.title_line_height }};
    font-weight: 400;
    letter-spacing: 0;
    color: var(--cj-services-muted);
  }

  #casa-juno-services-{{ section.id }} .cj-service-cta {
    margin-top: {{ section.settings.cta_margin_top_desktop }}px;
    display: inline-block;
    font-family: var(--font-body-family), "Times New Roman", serif;
    font-size: {{ section.settings.cta_size_desktop }}px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--cj-services-accent);
    text-decoration: none;
    cursor: pointer;
    transition: opacity 220ms ease, transform 220ms ease;
  }

  #casa-juno-services-{{ section.id }} .cj-service-cta:hover {
    opacity: 0.74;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 989px) {
    #casa-juno-services-{{ section.id }} {
      padding-top: 58px;
      padding-bottom: 58px;
    }

    #casa-juno-services-{{ section.id }} .cj-services-container {
      padding-left: 32px;
      padding-right: 32px;
    }

    #casa-juno-services-{{ section.id }} .cj-services-heading {
      margin-bottom: 44px;
      font-size: 30px;
      line-height: 1.18;
      text-align: center;
    }

    #casa-juno-services-{{ section.id }} .cj-services-grid {
      display: block;
    }

    #casa-juno-services-{{ section.id }} .cj-service-card {
      min-height: 150px;
      width: 100%;
      padding: 24px 28px 24px 0;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      text-align: left;
      position: relative;
    }

    #casa-juno-services-{{ section.id }} .cj-service-card::before {
      content: "›";
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      font-family: Arial, sans-serif;
      font-size: 34px;
      line-height: 1;
      font-weight: 300;
      color: var(--cj-services-text);
      opacity: 0.92;
    }

    #casa-juno-services-{{ section.id }} .cj-service-card:not(:last-child)::after {
      content: "";
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      width: auto;
      height: 1px;
      background: var(--cj-services-divider);
      opacity: 0.72;
    }

    #casa-juno-services-{{ section.id }} .cj-service-visual {
      width: 118px;
      height: 102px;
      margin: 0 26px 0 0;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      flex: 0 0 118px;
    }

    #casa-juno-services-{{ section.id }} .cj-service-icon {
      max-width: 118px;
      max-height: 98px;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    #casa-juno-services-{{ section.id }} .cj-service-icon--scooter {
      width: 126px !important;
      max-width: 126px !important;
      max-height: 94px !important;
      transform: scale(1.18);
      transform-origin: left center;
    }

    #casa-juno-services-{{ section.id }} .cj-service-icon--box {
      width: 122px !important;
      max-width: 122px !important;
      max-height: 94px !important;
      transform: scale(1.15);
      transform-origin: left center;
    }

    #casa-juno-services-{{ section.id }} .cj-service-icon--appointment {
      width: 128px !important;
      max-width: 128px !important;
      max-height: 102px !important;
      transform: scale(1.12);
      transform-origin: left center;
    }

    #casa-juno-services-{{ section.id }} .cj-service-placeholder {
      width: 118px;
      height: 98px;
    }

    #casa-juno-services-{{ section.id }} .cj-service-title {
      flex: 1 1 auto;
      max-width: none;
      margin: 0;
      font-size: 22px;
      line-height: 1.28;
      color: var(--cj-services-muted);
    }

    #casa-juno-services-{{ section.id }} .cj-service-cta {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    #casa-juno-services-{{ section.id }}.cj-services-section a {
      text-decoration: none;
    }
  }
</style>

{% schema %}
