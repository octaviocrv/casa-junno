{%- comment -%}
  ─────────────────────────────────────────────────────────────
  CASA JUNNO · JOURNAL
  Referência de estrutura: MR PORTER (Highlights + Discover More)
  Referência estética: Loro Piana · Kinfolk · The Journal

  Composição:
    1. Masthead editorial (kicker decorativo opcional + título + linha fina)
    2. HERO — matéria de abertura em tela cheia (nunca entra no trilho)
    3. EM DESTAQUE — trilho horizontal com scroll-snap, a partir da 2ª matéria
    4. DESCUBRA MAIS — grade editorial de 3 colunas com desalinho sutil
    5. Fecho discreto (link para o índice completo)

  Paleta: creme · areia · grafite-marrom · terracota (acento raro)
  Tipografia: Cormorant Garamond (serifada) + Jost (utilitária)
  Mobile: trilho vira swipe nativo, grade vira coluna única
  ─────────────────────────────────────────────────────────────
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400&family=Jost:wght@300;400;500&display=swap">

{%- liquid
  assign blog = blogs[section.settings.blog]
  assign blog_count = blog.articles_count | default: 0 | plus: 0
  assign hi_count = section.settings.highlights_count
  assign gr_count = section.settings.grid_count
  assign total = hi_count | plus: gr_count
  assign fallback_product_handles = 'sueter-gola-ziper|casa-juno-polo-ziper-premium|casa-juno-camiseta-signature|casa-juno-sueter-tricot-premium|casa-juno-calca-alfaiataria-casual' | split: '|'
  assign fallback_product_pool_size = fallback_product_handles.size | plus: 0

  assign fallback_highlight_titles = 'A alfaiataria que alonga a silhueta em segundos|Linho nobre no calor: caimento impecavel sem rigidez|Milao, Lisboa e Toquio: o que as ruas estao ensinando|Como identificar um tecido premium pelo toque e trama|A volta da cintura alta com proporcoes modernas|Do molde ao ponto final: dentro de um atelie contemporaneo|Capsule inteligente: 14 combinacoes para 7 dias|Couro bem cuidado: guia rapido para sapatos e bolsas' | split: '|'
  assign fallback_highlight_categories = 'Oficio|Tecidos|Cidades|Guia|Silhueta|Atelie|Curadoria|Acessorios' | split: '|'
  assign fallback_highlight_metas = '7 min de leitura|6 min de leitura|8 min de leitura|5 min de leitura|6 min de leitura|9 min de leitura|7 min de leitura|5 min de leitura' | split: '|'

  assign fallback_grid_titles = 'Tres camisas brancas alem do obvio|Tons areia, tabaco e grafite: paleta sem erro|Guia de sobreposicao leve para meia-estacao|Vestir bem para viajar com mala compacta|Joias discretas que transformam o look|Modelagens amplas: como equilibrar volume|Trench coat atualizado: comprimentos e ajustes|Denim escuro com acabamento refinado|O retorno do marrom chocolate no guarda-roupa|Pecas com textura para looks monocromaticos|Como escolher blazer pelo ombro e lapela|Perfumes de assinatura para cada horario' | split: '|'
  assign fallback_grid_categories = 'Estilo|Paleta|Camadas|Viagem|Acessorios|Modelagem|Outerwear|Denim|Tendencias|Texturas|Alfaiataria|Lifestyle' | split: '|'
  assign fallback_grid_metas = '4 min de leitura|5 min de leitura|6 min de leitura|5 min de leitura|4 min de leitura|6 min de leitura|5 min de leitura|4 min de leitura|5 min de leitura|4 min de leitura|6 min de leitura|4 min de leitura' | split: '|'
-%}

{% style %}
  #cj-journal-{{ section.id }} {
    --cj-bg:      {{ section.settings.bg_color }};
    --cj-panel:   {{ section.settings.panel_color }};
    --cj-ink:     {{ section.settings.ink_color }};
    --cj-muted:   {{ section.settings.muted_color }};
    --cj-accent:  {{ section.settings.accent_color }};
    --cj-rule:    {{ section.settings.ink_color | color_modify: 'alpha', 0.14 }};
    --cj-rule-soft:{{ section.settings.ink_color | color_modify: 'alpha', 0.07 }};

    --cj-serif: "Cormorant Garamond", "Times New Roman", Georgia, serif;
    --cj-sans:  "Jost", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;

    --cj-max:  {{ section.settings.max_width }}px;
    --cj-gap:  clamp(32px, 4vw, 56px);

    --cj-header-offset-desktop: max(
      118px,
      var(--main-content-padding-top, 0px),
      calc(var(--m-header-height, 0px) + var(--m-topbar-height, 0px) + var(--m-announcement-height, 0px))
    );
    --cj-header-offset-mobile: max(
      104px,
      var(--main-content-padding-top, 0px),
      calc(var(--m-header-height, 0px) + var(--m-topbar-height, 0px) + var(--m-announcement-height, 0px))
    );

    background: var(--cj-bg);
    color: var(--cj-ink);
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #cj-journal-{{ section.id }} *,
  #cj-journal-{{ section.id }} *::before,
  #cj-journal-{{ section.id }} *::after { box-sizing: border-box; }

  @media (min-width: 1024px) {
    #cj-journal-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px + var(--cj-header-offset-desktop));
    }
  }

  @media (max-width: 1023px) {
    #cj-journal-{{ section.id }} {
      padding-top: calc({{ section.settings.padding_top }}px + var(--cj-header-offset-mobile));
    }
  }

  #cj-journal-{{ section.id }} .cj-wrap {
    max-width: var(--cj-max);
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 64px);
  }

  /* ── 1. MASTHEAD ─────────────────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-masthead {
    text-align: center;
    max-width: 46ch;
    margin: 0 auto clamp(64px, 7vw, 112px);
  }
  #cj-journal-{{ section.id }} .cj-kicker {
    display: block;
    font-family: var(--cj-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .38em;
    text-transform: uppercase;
    color: var(--cj-muted);
    margin-bottom: 22px;
  }
  #cj-journal-{{ section.id }} .cj-display {
    font-family: var(--cj-serif);
    font-weight: 450;
    font-size: clamp(40px, 6.2vw, 82px);
    line-height: .96;
    letter-spacing: .06em;
    text-transform: uppercase;
    margin: 0;
  }
  #cj-journal-{{ section.id }} .cj-standfirst {
    font-family: var(--cj-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--cj-muted);
    margin: 26px auto 0;
    max-width: 40ch;
  }
  #cj-journal-{{ section.id }} .cj-mark {
    width: 1px; height: 46px;
    background: var(--cj-rule);
    margin: 34px auto 0;
  }

  /* ── Cabeçalhos de bloco ─────────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-blockhead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--cj-rule);
    margin-bottom: clamp(36px, 4vw, 60px);
  }
  #cj-journal-{{ section.id }} .cj-blocktitle {
    font-family: var(--cj-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--cj-ink);
    margin: 0;
  }
  #cj-journal-{{ section.id }} .cj-count {
    font-family: var(--cj-sans);
    font-size: 10px;
    letter-spacing: .18em;
    color: var(--cj-muted);
  }

  /* ── 3. TRILHO / EM DESTAQUE ─────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-railwrap { position: relative; }
  #cj-journal-{{ section.id }} .cj-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--cj-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  #cj-journal-{{ section.id }} .cj-rail::-webkit-scrollbar { display: none; }
  #cj-journal-{{ section.id }} .cj-rail > * { scroll-snap-align: start; }

  @media (min-width: 900px) {
    #cj-journal-{{ section.id }} .cj-rail { grid-auto-columns: calc((100% - var(--cj-gap)) / 2); }
  }
  @media (max-width: 899px) {
    #cj-journal-{{ section.id }} .cj-rail { grid-auto-columns: 82%; }
  }

  #cj-journal-{{ section.id }} .cj-nav { display: flex; gap: 6px; }
  #cj-journal-{{ section.id }} .cj-arrow {
    appearance: none;
    background: transparent;
    border: 1px solid var(--cj-rule);
    width: 42px; height: 42px;
    border-radius: 0;
    display: grid; place-items: center;
    cursor: pointer;
    color: var(--cj-ink);
    transition: background .5s ease, border-color .5s ease, opacity .35s ease;
  }
  #cj-journal-{{ section.id }} .cj-arrow:hover { background: var(--cj-panel); border-color: var(--cj-ink); }
  #cj-journal-{{ section.id }} .cj-arrow:focus-visible { outline: 1px solid var(--cj-accent); outline-offset: 3px; }
  #cj-journal-{{ section.id }} .cj-arrow[disabled] { opacity: .25; pointer-events: none; }
  #cj-journal-{{ section.id }} .cj-arrow svg { width: 8px; height: 14px; }

  /* ── Card base ───────────────────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-card { display: block; text-decoration: none; color: inherit; }
  #cj-journal-{{ section.id }} .cj-frame {
    position: relative;
    overflow: hidden;
    background: var(--cj-panel);
    aspect-ratio: 16 / 10;
  }
  #cj-journal-{{ section.id }} .cj-frame img,
  #cj-journal-{{ section.id }} .cj-frame svg {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 1.4s cubic-bezier(.2,.7,.2,1);
  }
  #cj-journal-{{ section.id }} .cj-card:hover .cj-frame img { transform: scale(1.045); }

  #cj-journal-{{ section.id }} .cj-body { padding-top: 20px; }
  #cj-journal-{{ section.id }} .cj-cat {
    font-family: var(--cj-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 17px;
    letter-spacing: .01em;
    color: var(--cj-accent);
    display: inline-block;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--cj-rule);
    margin-bottom: 14px;
  }
  #cj-journal-{{ section.id }} .cj-headline {
    font-family: var(--cj-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.3vw, 31px);
    line-height: 1.2;
    letter-spacing: .005em;
    margin: 0;
    background-image: linear-gradient(var(--cj-ink), var(--cj-ink));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size .6s cubic-bezier(.2,.7,.2,1);
    display: inline;
    padding-bottom: 2px;
  }
  #cj-journal-{{ section.id }} .cj-card:hover .cj-headline { background-size: 100% 1px; }
  #cj-journal-{{ section.id }} .cj-meta {
    font-family: var(--cj-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--cj-muted);
    margin: 16px 0 0;
  }

  /* ── 2. HERO EDITORIAL ───────────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-hero {
    position: relative;
    height: min(92vh, 860px);
    min-height: 480px;
    overflow: hidden;
    margin-bottom: clamp(64px, 7vw, 112px);
  }
  #cj-journal-{{ section.id }} .cj-hero-link,
  #cj-journal-{{ section.id }} .cj-hero-empty {
    position: relative;
    display: block;
    width: 100%; height: 100%;
    text-decoration: none;
    color: inherit;
  }
  #cj-journal-{{ section.id }} .cj-hero-frame {
    position: absolute;
    inset: 0;
  }
  #cj-journal-{{ section.id }} .cj-hero-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 38%, rgba(0,0,0,.64) 100%);
  }
  #cj-journal-{{ section.id }} .cj-hero-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.001);
    transition: transform 1.6s cubic-bezier(.2,.7,.2,1);
  }
  #cj-journal-{{ section.id }} .cj-hero-link:hover .cj-hero-frame img { transform: scale(1.035); }
  #cj-journal-{{ section.id }} .cj-hero-content {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: clamp(28px, 4vw, 64px);
    max-width: 62ch;
    color: #F5F2EC;
  }
  #cj-journal-{{ section.id }} .cj-hero-cat {
    font-family: var(--cj-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 18px;
    letter-spacing: .01em;
    color: #F5F2EC;
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(245,242,236,.5);
    margin-bottom: 20px;
  }
  #cj-journal-{{ section.id }} .cj-hero-title {
    font-family: var(--cj-serif);
    font-weight: 500;
    font-size: clamp(36px, 6vw, 88px);
    line-height: 1.02;
    letter-spacing: .01em;
    color: #FFFFFF;
    margin: 0 0 26px;
  }
  #cj-journal-{{ section.id }} .cj-hero-cta {
    font-family: var(--cj-sans);
    font-size: 11px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: #F5F2EC;
    display: inline-block;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(245,242,236,.6);
    transition: border-color .5s ease, opacity .5s ease;
  }
  #cj-journal-{{ section.id }} .cj-hero-link:hover .cj-hero-cta { border-color: var(--cj-accent); }

  /* ── 4. GRADE / DESCUBRA MAIS ────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-blockhead--grid { margin-top: clamp(96px, 9vw, 148px); }
  #cj-journal-{{ section.id }} .cj-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(56px, 5vw, 84px) var(--cj-gap);
    align-items: start;
  }
  @media (min-width: 640px) {
    #cj-journal-{{ section.id }} .cj-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    #cj-journal-{{ section.id }} .cj-grid { grid-template-columns: repeat(3, 1fr); }
    /* desalinho editorial: colunas respiram em alturas diferentes */
    #cj-journal-{{ section.id }} .cj-grid > *:nth-child(3n+2) { margin-top: 64px; }
    #cj-journal-{{ section.id }} .cj-grid > *:nth-child(3n+3) { margin-top: 128px; }
    #cj-journal-{{ section.id }} .cj-grid > *:nth-child(3n+2) .cj-frame { aspect-ratio: 4 / 5; }
    #cj-journal-{{ section.id }} .cj-grid > *:nth-child(3n+3) .cj-frame { aspect-ratio: 3 / 2; }
  }

  /* ── 5. FECHO ────────────────────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-close {
    margin-top: clamp(88px, 8vw, 136px);
    padding-top: 30px;
    border-top: 1px solid var(--cj-rule);
    text-align: center;
  }
  #cj-journal-{{ section.id }} .cj-cta {
    font-family: var(--cj-sans);
    font-size: 11px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--cj-ink);
    text-decoration: none;
    display: inline-block;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--cj-rule);
    transition: border-color .5s ease, color .5s ease;
  }
  #cj-journal-{{ section.id }} .cj-cta:hover { border-color: var(--cj-accent); color: var(--cj-accent); }

  /* ── Entrada suave ───────────────────────────────────────── */
  #cj-journal-{{ section.id }} .cj-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(.2,.7,.2,1);
  }
  #cj-journal-{{ section.id }} .cj-reveal.is-in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    #cj-journal-{{ section.id }} .cj-reveal { opacity: 1; transform: none; transition: none; }
    #cj-journal-{{ section.id }} .cj-rail { scroll-behavior: auto; }
    #cj-journal-{{ section.id }} .cj-frame img,
    #cj-journal-{{ section.id }} .cj-hero-frame img,
    #cj-journal-{{ section.id }} .cj-headline { transition: none; }
  }
{% endstyle %}

<section id="cj-journal-{{ section.id }}" aria-labelledby="cj-journal-title-{{ section.id }}">
  <div class="cj-wrap">

    {%- comment -%} ── 1. MASTHEAD ── {%- endcomment -%}
    <header class="cj-masthead cj-reveal">
      {%- if section.settings.kicker != blank -%}
        <span class="cj-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="cj-display" id="cj-journal-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.standfirst != blank -%}
        <p class="cj-standfirst">{{ section.settings.standfirst }}</p>
      {%- endif -%}
      <div class="cj-mark" aria-hidden="true"></div>
    </header>

    {%- comment -%} ── 2. HERO EDITORIAL ── {%- endcomment -%}
    <div class="cj-hero cj-reveal">
      {%- if blog_count > 0 -%}
        {%- liquid
          assign hero_article = blog.articles.first
          assign hero_category = hero_article.tags.first | default: section.settings.default_category
        -%}
        <a class="cj-hero-link" href="{{ hero_article.url }}">
          <div class="cj-hero-frame">
            {%- if hero_article.image -%}
              <img src="{{ hero_article.image | image_url: width: 2200 }}"
                   alt="{{ hero_article.image.alt | escape }}"
                   width="2200" height="1375" loading="eager">
            {%- elsif section.settings.fallback_highlight_image_1 != blank -%}
              <img src="{{ section.settings.fallback_highlight_image_1 | image_url: width: 2200 }}"
                   alt="{{ hero_article.title | escape }}"
                   width="2200" height="1375" loading="eager">
            {%- else -%}
              {%- liquid
                assign hero_pool_handle = fallback_product_handles[0]
                assign hero_pool_product = all_products[hero_pool_handle]
              -%}
              {%- if hero_pool_product != blank and hero_pool_product.featured_image != blank -%}
                <img src="{{ hero_pool_product.featured_image | image_url: width: 2200 }}"
                     alt="{{ hero_pool_product.title | default: hero_article.title | escape }}"
                     width="2200" height="1375" loading="eager">
              {%- else -%}
                <img src="#sua-imagem-aqui#"
                     alt="{{ hero_article.title | escape }}"
                     width="2200" height="1375" loading="eager">
              {%- endif -%}
            {%- endif -%}
          </div>
          <div class="cj-hero-content">
            <span class="cj-hero-cat">{{ hero_category }}</span>
            <h3 class="cj-hero-title">{{ hero_article.title }}</h3>
            <span class="cj-hero-cta">{{ section.settings.hero_cta_label }}</span>
          </div>
        </a>
      {%- else -%}
        {%- liquid
          assign hero_title = fallback_highlight_titles[0]
          assign hero_category = fallback_highlight_categories[0] | default: section.settings.default_category
          assign hero_image = section.settings.fallback_highlight_image_1
        -%}
        <div class="cj-hero-empty">
          <div class="cj-hero-frame">
            {%- if hero_image != blank -%}
              <img src="{{ hero_image | image_url: width: 2200 }}" alt="{{ hero_title | escape }}" width="2200" height="1375" loading="eager">
            {%- else -%}
              {%- liquid
                assign hero_pool_handle = fallback_product_handles[0]
                assign hero_pool_product = all_products[hero_pool_handle]
              -%}
              {%- if hero_pool_product != blank and hero_pool_product.featured_image != blank -%}
                <img src="{{ hero_pool_product.featured_image | image_url: width: 2200 }}" alt="{{ hero_pool_product.title | default: hero_title | escape }}" width="2200" height="1375" loading="eager">
              {%- else -%}
                <img src="#sua-imagem-aqui#" alt="{{ hero_title | escape }}" width="2200" height="1375" loading="eager">
              {%- endif -%}
            {%- endif -%}
          </div>
          <div class="cj-hero-content">
            <span class="cj-hero-cat">{{ hero_category }}</span>
            <h3 class="cj-hero-title">{{ hero_title }}</h3>
            <span class="cj-hero-cta">{{ section.settings.hero_cta_label }}</span>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── 3. EM DESTAQUE (a partir da 2ª matéria) ── {%- endcomment -%}
    {%- liquid
      assign rail_count = hi_count | minus: 1
    -%}
    <div class="cj-railwrap cj-reveal">
      <div class="cj-blockhead">
        <h3 class="cj-blocktitle">{{ section.settings.highlights_title }}</h3>
        <div class="cj-nav">
          <button class="cj-arrow" type="button" data-rail-prev aria-label="Matérias anteriores" disabled>
            <svg viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M7 1 1 7l6 6" stroke="currentColor" stroke-width="1"/></svg>
          </button>
          <button class="cj-arrow" type="button" data-rail-next aria-label="Próximas matérias">
            <svg viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="m1 1 6 6-6 6" stroke="currentColor" stroke-width="1"/></svg>
          </button>
        </div>
      </div>

      <div class="cj-rail" data-rail tabindex="0" role="group" aria-label="{{ section.settings.highlights_title }}">
        {%- if blog_count > 0 -%}
          {%- for article in blog.articles offset: 1 limit: rail_count -%}
            {%- liquid
              assign words = article.content | strip_html | split: ' ' | size
              assign minutes = words | divided_by: 210 | plus: 1
              assign category = article.tags.first | default: section.settings.default_category
              assign h_image_num = forloop.index | plus: 1
              assign h_image_key = 'fallback_highlight_image_' | append: h_image_num
              assign h_image = section.settings[h_image_key]
            -%}
            <a class="cj-card" href="{{ article.url }}">
              <div class="cj-frame">
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 1400 }}"
                       alt="{{ article.image.alt | escape }}"
                       width="1400" height="875" loading="lazy">
                {%- elsif h_image != blank -%}
                  <img src="{{ h_image | image_url: width: 1400 }}"
                       alt="{{ article.title | escape }}"
                       width="1400" height="875" loading="lazy">
                {%- else -%}
                  {%- liquid
                    assign h_pool_index = forloop.index0 | plus: 1 | modulo: fallback_product_pool_size
                    assign h_pool_handle = fallback_product_handles[h_pool_index]
                    assign h_pool_product = all_products[h_pool_handle]
                  -%}
                  {%- if h_pool_product != blank and h_pool_product.featured_image != blank -%}
                    <img src="{{ h_pool_product.featured_image | image_url: width: 1400 }}"
                         alt="{{ h_pool_product.title | default: article.title | escape }}"
                         width="1400" height="875" loading="lazy">
                  {%- else -%}
                    <img src="#sua-imagem-aqui#"
                         alt="{{ article.title | escape }}"
                         width="1400" height="875" loading="lazy">
                  {%- endif -%}
                {%- endif -%}
              </div>
              <div class="cj-body">
                <span class="cj-cat">{{ category }}</span>
                <h4 class="cj-headline">{{ article.title }}</h4>
                {%- if section.settings.show_readtime -%}
                  <p class="cj-meta">{{ minutes }} min de leitura</p>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Estado vazio: mantém a composição legível no editor {%- endcomment -%}
          {%- for i in (1..rail_count) -%}
            {%- liquid
              assign h_idx = i
              assign h_title = fallback_highlight_titles[h_idx] | default: fallback_highlight_titles.last
              assign h_category = fallback_highlight_categories[h_idx] | default: section.settings.default_category
              assign h_meta = fallback_highlight_metas[h_idx] | default: '5 min de leitura'
              assign h_image_num = h_idx | plus: 1
              assign h_image_key = 'fallback_highlight_image_' | append: h_image_num
              assign h_image = section.settings[h_image_key]
            -%}
            <div class="cj-card">
              <div class="cj-frame">
                {%- if h_image != blank -%}
                  <img src="{{ h_image | image_url: width: 1400 }}" alt="{{ h_title | escape }}" width="1400" height="875" loading="lazy">
                {%- else -%}
                  {%- liquid
                    assign h_pool_index = h_idx | modulo: fallback_product_pool_size
                    assign h_pool_handle = fallback_product_handles[h_pool_index]
                    assign h_pool_product = all_products[h_pool_handle]
                  -%}
                  {%- if h_pool_product != blank and h_pool_product.featured_image != blank -%}
                    <img src="{{ h_pool_product.featured_image | image_url: width: 1400 }}" alt="{{ h_pool_product.title | default: h_title | escape }}" width="1400" height="875" loading="lazy">
                  {%- else -%}
                    <img src="#sua-imagem-aqui#" alt="{{ h_title | escape }}" width="1400" height="875" loading="lazy">
                  {%- endif -%}
                {%- endif -%}
              </div>
              <div class="cj-body">
                <span class="cj-cat">{{ h_category }}</span>
                <h4 class="cj-headline">{{ h_title }}</h4>
                {%- if section.settings.show_readtime -%}
                  <p class="cj-meta">{{ h_meta }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── 4. DESCUBRA MAIS ── {%- endcomment -%}
    <div class="cj-blockhead cj-blockhead--grid cj-reveal">
      <h3 class="cj-blocktitle">{{ section.settings.grid_title }}</h3>
      {%- if blog_count > 0 -%}
        <span class="cj-count">{{ blog_count }} matérias</span>
      {%- endif -%}
    </div>

    <div class="cj-grid cj-reveal">
      {%- if blog_count > 0 -%}
        {%- for article in blog.articles offset: hi_count limit: gr_count -%}
          {%- liquid
            assign words = article.content | strip_html | split: ' ' | size
            assign minutes = words | divided_by: 210 | plus: 1
            assign category = article.tags.first | default: section.settings.default_category
            assign g_image_key = 'fallback_grid_image_' | append: forloop.index
            assign g_image = section.settings[g_image_key]
          -%}
          <a class="cj-card" href="{{ article.url }}">
            <div class="cj-frame">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 900 }}"
                     alt="{{ article.image.alt | escape }}"
                     width="900" height="600" loading="lazy">
              {%- elsif g_image != blank -%}
                <img src="{{ g_image | image_url: width: 900 }}"
                     alt="{{ article.title | escape }}"
                     width="900" height="600" loading="lazy">
              {%- else -%}
                {%- liquid
                  assign g_pool_index = forloop.index0 | plus: hi_count | modulo: fallback_product_pool_size
                  assign g_pool_handle = fallback_product_handles[g_pool_index]
                  assign g_pool_product = all_products[g_pool_handle]
                -%}
                {%- if g_pool_product != blank and g_pool_product.featured_image != blank -%}
                  <img src="{{ g_pool_product.featured_image | image_url: width: 900 }}"
                       alt="{{ g_pool_product.title | default: article.title | escape }}"
                       width="900" height="600" loading="lazy">
                {%- else -%}
                  <img src="#sua-imagem-aqui#"
                       alt="{{ article.title | escape }}"
                       width="900" height="600" loading="lazy">
                {%- endif -%}
              {%- endif -%}
            </div>
            <div class="cj-body">
              <span class="cj-cat">{{ category }}</span>
              <h4 class="cj-headline">{{ article.title }}</h4>
              {%- if section.settings.show_readtime -%}
                <p class="cj-meta">{{ minutes }} min de leitura</p>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..gr_count) -%}
          {%- liquid
            assign g_idx = forloop.index0
            assign g_title = fallback_grid_titles[g_idx] | default: fallback_grid_titles.last
            assign g_category = fallback_grid_categories[g_idx] | default: section.settings.default_category
            assign g_meta = fallback_grid_metas[g_idx] | default: '4 min de leitura'
            assign g_image_key = 'fallback_grid_image_' | append: forloop.index
            assign g_image = section.settings[g_image_key]
          -%}
          <div class="cj-card">
            <div class="cj-frame">
              {%- if g_image != blank -%}
                <img src="{{ g_image | image_url: width: 900 }}" alt="{{ g_title | escape }}" width="900" height="600" loading="lazy">
              {%- else -%}
                {%- liquid
                  assign g_pool_index = g_idx | plus: hi_count | modulo: fallback_product_pool_size
                  assign g_pool_handle = fallback_product_handles[g_pool_index]
                  assign g_pool_product = all_products[g_pool_handle]
                -%}
                {%- if g_pool_product != blank and g_pool_product.featured_image != blank -%}
                  <img src="{{ g_pool_product.featured_image | image_url: width: 900 }}" alt="{{ g_pool_product.title | default: g_title | escape }}" width="900" height="600" loading="lazy">
                {%- else -%}
                  <img src="#sua-imagem-aqui#" alt="{{ g_title | escape }}" width="900" height="600" loading="lazy">
                {%- endif -%}
              {%- endif -%}
            </div>
            <div class="cj-body">
              <span class="cj-cat">{{ g_category }}</span>
              <h4 class="cj-headline">{{ g_title }}</h4>
              {%- if section.settings.show_readtime -%}
                <p class="cj-meta">{{ g_meta }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} ── 5. FECHO ── {%- endcomment -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="cj-close cj-reveal">
        <a class="cj-cta" href="{{ section.settings.cta_url | default: blog.url }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('cj-journal-{{ section.id }}');
    if (!root) return;

    /* Trilho: navegação por página visível */
    var rail = root.querySelector('[data-rail]');
    var prev = root.querySelector('[data-rail-prev]');
    var next = root.querySelector('[data-rail-next]');

    if (rail && prev && next) {
      var step = function () {
        var first = rail.firstElementChild;
        if (!first) return rail.clientWidth;
        var gap = parseFloat(getComputedStyle(rail).columnGap || '0') || 0;
        return first.getBoundingClientRect().width + gap;
      };
      var sync = function () {
        var max = rail.scrollWidth - rail.clientWidth - 2;
        prev.disabled = rail.scrollLeft <= 2;
        next.disabled = rail.scrollLeft >= max;
      };
      prev.addEventListener('click', function () { rail.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { rail.scrollBy({ left:  step(), behavior: 'smooth' }); });
      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }

    /* Entrada suave, uma vez por elemento */
    var items = root.querySelectorAll('.cj-reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
    items.forEach(function (el) { io.observe(el); });
  })();
</script>

