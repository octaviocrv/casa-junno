{% liquid
  assign sid = section.id
%}

<section
  id="CasaJunoEditorials-{{ sid }}"
  class="cj-editorials-section"
  style="
    --cj-bg: {{ section.settings.background_color }};
    --cj-text: {{ section.settings.text_color }};
    --cj-muted: {{ section.settings.muted_color }};
    --cj-accent: {{ section.settings.accent_color }};
    --cj-max-width: {{ section.settings.max_width }}px;
    --cj-padding-top: {{ section.settings.padding_top }}px;
    --cj-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cj-gap: {{ section.settings.column_gap }}px;
    --cj-image-height: {{ section.settings.image_height }}px;
    --cj-image-radius: {{ section.settings.image_radius }}px;
    --cj-card-gap: {{ section.settings.card_text_gap }}px;
    --cj-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --cj-mobile-gap: {{ section.settings.mobile_gap }}px;
  "
>
  <div class="cj-editorials-inner">

    {% if section.settings.small_heading != blank or section.settings.heading != blank or section.settings.description != blank %}
      <div class="cj-editorials-heading">
        {% if section.settings.small_heading != blank %}
          <div class="cj-editorials-small">
            {{ section.settings.small_heading }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="cj-editorials-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="cj-editorials-description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="cj-editorials-grid">
      {% for block in section.blocks %}
        {% liquid
          assign image = block.settings.image
          assign link = block.settings.link
          assign eyebrow = block.settings.eyebrow
          assign title = block.settings.title
          assign button_text = block.settings.button_text
        %}

        <article class="cj-editorial-card" {{ block.shopify_attributes }}>
          {% if link != blank %}
            <a class="cj-editorial-link" href="{{ link }}" aria-label="{{ title | escape }}">
          {% else %}
            <div class="cj-editorial-link">
          {% endif %}

            <div class="cj-editorial-image-wrap">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'cj-editorial-image',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(max-width: 749px) 100vw, 33vw',
                    alt: title
                }}
              {% else %}
                <div class="cj-editorial-placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="cj-editorial-content">
              {% if eyebrow != blank %}
                <div class="cj-editorial-eyebrow">
                  {{ eyebrow }}
                </div>
              {% endif %}

              {% if title != blank %}
                <h3 class="cj-editorial-title">
                  {{ title }}
                </h3>
              {% endif %}

              {% if button_text != blank %}
                <div class="cj-editorial-cta">
                  <span class="cj-cta-text">{{ button_text }}</span>
                </div>
              {% endif %}
            </div>

          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #CasaJunoEditorials-{{ sid }} {
    background: var(--cj-bg);
    color: var(--cj-text);
    padding-top: var(--cj-padding-top);
    padding-bottom: var(--cj-padding-bottom);
    overflow: hidden;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-inner {
    width: 100%;
    max-width: var(--cj-max-width);
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-heading {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 72px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-small {
    font-family: var(--font-body-family, "Helvetica Neue", sans-serif);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--cj-accent);
    margin-bottom: 16px;
    opacity: 0.8;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-title {
    margin: 0;
    font-family: var(--font-heading-family, "Playfair Display", "Georgia", serif);
    font-size: clamp(32px, 3.5vw, 56px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--cj-text);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-description {
    margin-top: 24px;
    font-family: var(--font-body-family, inherit);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--cj-muted);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cj-gap);
    align-items: start;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-card {
    min-width: 0;
    text-align: center;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-link {
    display: block;
    text-decoration: none;
    color: inherit;
    group: hover;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-image-wrap {
    position: relative;
    width: 100%;
    height: var(--cj-image-height);
    overflow: hidden;
    border-radius: var(--cj-image-radius);
    background: #EBEBEB;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-link:hover .cj-editorial-image {
    transform: scale(1.04);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-placeholder {
    width: 100%;
    height: 100%;
    background: #EBEBEB;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-content {
    padding-top: var(--cj-card-gap);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-eyebrow {
    font-family: var(--font-body-family, inherit);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cj-muted);
    margin-bottom: 12px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-title {
    margin: 0;
    font-family: var(--font-heading-family, "Playfair Display", "Georgia", serif);
    font-size: clamp(20px, 1.8vw, 32px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--cj-text);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-cta {
    margin-top: 18px;
    font-family: var(--font-body-family, inherit);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cj-accent);
    display: inline-block;
    position: relative;
    padding-bottom: 4px;
  }

  /* Quiet Luxury Underline Hover Effect */
  #CasaJunoEditorials-{{ sid }} .cj-editorial-cta::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--cj-accent);
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-link:hover .cj-editorial-cta::after {
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    #CasaJunoEditorials-{{ sid }} .cj-editorials-inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-grid {
      gap: 32px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-image-wrap {
      height: calc(var(--cj-image-height) * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    #CasaJunoEditorials-{{ sid }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-heading {
      margin-bottom: 48px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-grid {
      grid-template-columns: 1fr;
      gap: var(--cj-mobile-gap);
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-image-wrap {
      height: var(--cj-mobile-image-height);
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-content {
      padding-top: 20px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-title {
      font-size: 26px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-cta {
      margin-top: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Casa Juno produtos",
  "tag": "section",
  "class": "section-casa-juno-editorials",
  "settings": [
    {
      "type": "header",
      "content": "Topo da seção"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "Texto pequeno acima",
      "default": "A Essência"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Seleção Curada"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição",
      "default": "Peças atemporais desenvolvidas com precisão para o guarda-roupa masculino."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largura máxima",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Altura das imagens desktop",
      "min": 360,
      "max": 780,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Altura das imagens mobile",
      "min": 300,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Espaço entre colunas",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espaço entre cards mobile",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_text_gap",
      "label": "Distância da imagem para textos",
      "min": 14,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arredondamento das imagens",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding topo desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding baixo desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding topo mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding baixo mobile",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor do fundo",
      "default": "#F7F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto principal",
      "default": "#1C1B1A"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Cor da descrição",
      "default": "#7D756D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor do botão/links",
      "default": "#1C1B1A"
    }
  ],
  "blocks": [
    {
      "type": "produto",
      "name": "Produto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto pequeno",
          "default": "Lançamento"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Nome da Peça"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto do link",
          "default": "Explorar"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do produto ou coleção"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Casa Juno produtos",
      "blocks": [
        {
          "type": "produto",
          "settings": {
            "eyebrow": "Linha Essencial",
            "title": "Polo em Algodão Pima",
            "button_text": "Explorar"
          }
        },
        {
          "type": "produto",
          "settings": {
            "eyebrow": "Alfaiataria Moderna",
            "title": "Calça Chino Refinada",
            "button_text": "Explorar"
          }
        },
        {
          "type": "produto",
          "settings": {
            "eyebrow": "Transição de Estação",
            "title": "Tricot Modal Leve",
            "button_text": "Explorar"
          }
        }
      ]
    }
  ]
}
{% endschema %}