{% liquid
  assign sid = section.id
%}

<section
  id="CasaJunoEditorials-{{ sid }}"
  class="cj-editorials-section"
  style="
    --cj-bg: {{ section.settings.background_color }};
    --cj-text: {{ section.settings.text_color }};
    --cj-muted: {{ section.settings.muted_color }};
    --cj-accent: {{ section.settings.accent_color }};
    --cj-max-width: {{ section.settings.max_width }}px;
    --cj-padding-top: {{ section.settings.padding_top }}px;
    --cj-padding-bottom: {{ section.settings.padding_bottom }}px;
    --cj-gap: {{ section.settings.column_gap }}px;
    --cj-image-height: {{ section.settings.image_height }}px;
    --cj-image-radius: {{ section.settings.image_radius }}px;
    --cj-card-gap: {{ section.settings.card_text_gap }}px;
    --cj-mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --cj-mobile-gap: {{ section.settings.mobile_gap }}px;
  "
>
  <div class="cj-editorials-inner">

    {% if section.settings.small_heading != blank or section.settings.heading != blank or section.settings.description != blank %}
      <div class="cj-editorials-heading">
        {% if section.settings.small_heading != blank %}
          <div class="cj-editorials-small">
            {{ section.settings.small_heading }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="cj-editorials-title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="cj-editorials-description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="cj-editorials-grid">
      {% for block in section.blocks %}
        {% liquid
          assign image = block.settings.image
          assign link = block.settings.link
          assign eyebrow = block.settings.eyebrow
          assign title = block.settings.title
          assign button_text = block.settings.button_text
        %}

        <article class="cj-editorial-card" {{ block.shopify_attributes }}>
          {% if link != blank %}
            <a class="cj-editorial-link" href="{{ link }}" aria-label="{{ title | escape }}">
          {% else %}
            <div class="cj-editorial-link">
          {% endif %}

            <div class="cj-editorial-image-wrap">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'cj-editorial-image',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(max-width: 749px) 100vw, 33vw',
                    alt: title
                }}
              {% else %}
                <div class="cj-editorial-placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="cj-editorial-content">
              {% if eyebrow != blank %}
                <div class="cj-editorial-eyebrow">
                  {{ eyebrow }}
                </div>
              {% endif %}

              {% if title != blank %}
                <h3 class="cj-editorial-title">
                  {{ title }}
                </h3>
              {% endif %}

              {% if button_text != blank %}
                <div class="cj-editorial-cta">
                  — {{ button_text }} —
                </div>
              {% endif %}
            </div>

          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #CasaJunoEditorials-{{ sid }} {
    background: var(--cj-bg);
    color: var(--cj-text);
    padding-top: var(--cj-padding-top);
    padding-bottom: var(--cj-padding-bottom);
    overflow: hidden;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-inner {
    width: 100%;
    max-width: var(--cj-max-width);
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 58px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-small {
    font-family: var(--font-body-family, inherit);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cj-accent);
    margin-bottom: 12px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-title {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(30px, 3vw, 52px);
    font-weight: 400;
    line-height: 1.08;
    color: var(--cj-text);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-description {
    margin-top: 18px;
    font-family: var(--font-body-family, inherit);
    font-size: 15px;
    line-height: 1.8;
    color: var(--cj-muted);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorials-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--cj-gap);
    align-items: start;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-card {
    min-width: 0;
    text-align: center;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-image-wrap {
    position: relative;
    width: 100%;
    height: var(--cj-image-height);
    overflow: hidden;
    border-radius: var(--cj-image-radius);
    background: #f4eee6;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition:
      transform 1200ms cubic-bezier(.16, 1, .3, 1),
      filter 1200ms cubic-bezier(.16, 1, .3, 1);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-link:hover .cj-editorial-image {
    transform: scale(1.035);
    filter: brightness(0.98);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-placeholder {
    width: 100%;
    height: 100%;
    background: #f4eee6;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-placeholder svg {
    width: 48%;
    height: 48%;
    opacity: 0.35;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-content {
    padding-top: var(--cj-card-gap);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-eyebrow {
    font-family: var(--font-body-family, inherit);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--cj-text);
    margin-bottom: 8px;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-title {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(22px, 1.8vw, 34px);
    font-weight: 400;
    line-height: 1.14;
    color: var(--cj-text);
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-cta {
    margin-top: 12px;
    font-family: var(--font-body-family, inherit);
    font-size: 15px;
    line-height: 1.4;
    color: var(--cj-accent);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  #CasaJunoEditorials-{{ sid }} .cj-editorial-link:hover .cj-editorial-cta {
    opacity: 0.75;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 989px) {
    #CasaJunoEditorials-{{ sid }} .cj-editorials-inner {
      padding-left: 24px;
      padding-right: 24px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-grid {
      gap: 28px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-image-wrap {
      height: calc(var(--cj-image-height) * 0.78);
    }
  }

  @media screen and (max-width: 749px) {
    #CasaJunoEditorials-{{ sid }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-inner {
      padding-left: 18px;
      padding-right: 18px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-heading {
      margin-bottom: 34px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorials-grid {
      grid-template-columns: 1fr;
      gap: var(--cj-mobile-gap);
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-image-wrap {
      height: var(--cj-mobile-image-height);
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-content {
      padding-top: 16px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-title {
      font-size: 25px;
    }

    #CasaJunoEditorials-{{ sid }} .cj-editorial-cta {
      font-size: 15px;
      margin-top: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Casa Juno produtos",
  "tag": "section",
  "class": "section-casa-juno-editorials",
  "settings": [
    {
      "type": "header",
      "content": "Topo da seção"
    },
    {
      "type": "text",
      "id": "small_heading",
      "label": "Texto pequeno acima",
      "default": "Casa Juno"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Seleção essencial"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição",
      "default": "Peças criadas para um guarda-roupa masculino atemporal."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largura máxima",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1500
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Altura das imagens desktop",
      "min": 360,
      "max": 780,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Altura das imagens mobile",
      "min": 300,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Espaço entre colunas",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espaço entre cards mobile",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "card_text_gap",
      "label": "Distância da imagem para textos",
      "min": 14,
      "max": 54,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arredondamento das imagens",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding topo desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding baixo desktop",
      "min": 0,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding topo mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding baixo mobile",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor do fundo",
      "default": "#F4EEE6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto principal",
      "default": "#2A1810"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Cor da descrição",
      "default": "#6F6258"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor do Discover More",
      "default": "#9A3F32"
    }
  ],
  "blocks": [
    {
      "type": "produto",
      "name": "Produto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto pequeno",
          "default": "Primavera / Verão"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Produto Casa Juno"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto do link",
          "default": "Descubra agora"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do produto ou coleção"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Casa Juno produtos",
      "blocks": [
        {
          "type": "produto",
          "settings": {
            "eyebrow": "Primavera / Verão",
            "title": "Polo Premium",
            "button_text": "Descubra agora"
          }
        },
        {
          "type": "produto",
          "settings": {
            "eyebrow": "Primavera / Verão",
            "title": "Tricot Leve",
            "button_text": "Descubra agora"
          }
        },
        {
          "type": "produto",
          "settings": {
            "eyebrow": "Primavera / Verão",
            "title": "Alfaiataria Casual",
            "button_text": "Descubra agora"
          }
        }
      ]
    }
  ]
}
{% endschema %}