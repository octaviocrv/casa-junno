{% comment %}
  Section: Casa Juno Look + Collections
{% endcomment %}

<section id="CasaJunoLookCollections-{{ section.id }}" class="cj-look-collections">
  <div class="cj-lc-inner">

    {% if section.settings.show_collection_grid %}
      <div class="cj-collection-grid">
        {% for block in section.blocks %}
          {% if block.type == 'collection_card' %}
            <a
              class="cj-collection-card"
              href="{{ block.settings.link | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              <div class="cj-collection-image-wrap">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'cj-collection-image',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(max-width: 768px) 100vw, 33vw'
                  }}
                {% else %}
                  <div class="cj-placeholder"></div>
                {% endif %}
              </div>

              <div class="cj-collection-content">
                {% if block.settings.eyebrow != blank %}
                  <p class="cj-eyebrow">{{ block.settings.eyebrow }}</p>
                {% endif %}

                {% if block.settings.title != blank %}
                  <h3 class="cj-collection-title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.link_label != blank %}
                  <span class="cj-discover">{{ block.settings.link_label }}</span>
                {% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.show_look_section %}
      <div class="cj-look-area">

        <div class="cj-look-main">
          <div class="cj-look-main-image-wrap">
            {% if section.settings.look_image != blank %}
              {{
                section.settings.look_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  class: 'cj-look-main-image',
                  widths: '600, 900, 1200, 1500, 1800',
                  sizes: '(max-width: 768px) 100vw, 50vw'
              }}
            {% else %}
              <div class="cj-placeholder cj-look-placeholder"></div>
            {% endif %}
          </div>
        </div>

        <div class="cj-look-products">
          {% if section.settings.look_heading != blank %}
            <h2 class="cj-look-heading">{{ section.settings.look_heading }}</h2>
          {% endif %}

          <div class="cj-look-slider-shell">
            <button class="cj-look-arrow cj-look-prev" type="button" aria-label="Produto anterior">
              &#8249;
            </button>

            <div class="cj-look-slider" data-cj-look-slider>
              {% for block in section.blocks %}
                {% if block.type == 'look_product' %}
                  <a
                    href="{{ block.settings.product_link | default: '#' }}"
                    class="cj-look-slide"
                    {{ block.shopify_attributes }}
                  >
                    <div class="cj-look-product-image-wrap">
                      {% if block.settings.product_image != blank %}
                        {{
                          block.settings.product_image
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            class: 'cj-look-product-image',
                            widths: '300, 500, 700, 900',
                            sizes: '(max-width: 768px) 72vw, 280px'
                        }}
                      {% else %}
                        <div class="cj-placeholder"></div>
                      {% endif %}
                    </div>

                    <div class="cj-look-product-info">
                      {% if block.settings.product_title != blank %}
                        <h3>{{ block.settings.product_title }}</h3>
                      {% endif %}

                      {% if block.settings.product_material != blank %}
                        <p>{{ block.settings.product_material }}</p>
                      {% endif %}
                    </div>
                  </a>
                {% endif %}
              {% endfor %}
            </div>

            <button class="cj-look-arrow cj-look-next" type="button" aria-label="Próximo produto">
              &#8250;
            </button>
          </div>

          {% if section.settings.look_link_label != blank %}
            <a href="{{ section.settings.look_link | default: '#' }}" class="cj-look-all">
              {{ section.settings.look_link_label }}
            </a>
          {% endif %}
        </div>

      </div>
    {% endif %}

  </div>
</section>

<style>
  #CasaJunoLookCollections-{{ section.id }} {
    --cj-bg: {{ section.settings.background_color }};
    --cj-card-bg: {{ section.settings.card_background }};
    --cj-text: {{ section.settings.text_color }};
    --cj-muted: {{ section.settings.muted_color }};
    --cj-accent: {{ section.settings.accent_color }};
    --cj-max: {{ section.settings.max_width }}px;

    background: var(--cj-bg);
    color: var(--cj-text);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-lc-inner {
    width: min(var(--cj-max), calc(100% - 48px));
    margin: 0 auto;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    margin-bottom: {{ section.settings.space_between_sections }}px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-image-wrap {
    width: 100%;
    background: var(--cj-card-bg);
    overflow: hidden;
    aspect-ratio: {{ section.settings.card_ratio }};
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s cubic-bezier(.16, 1, .3, 1);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-card:hover .cj-collection-image {
    transform: scale(1.035);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-content {
    text-align: center;
    padding-top: 28px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--cj-text);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-collection-title {
    margin: 0 0 12px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--cj-text);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-discover {
    display: inline-block;
    font-size: 15px;
    line-height: 1.3;
    color: var(--cj-accent);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-discover::before,
  #CasaJunoLookCollections-{{ section.id }} .cj-discover::after {
    content: '–';
    margin: 0 4px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-area {
    display: grid;
    grid-template-columns: 52% 48%;
    min-height: {{ section.settings.look_height }}px;
    background: {{ section.settings.look_background }};
    overflow: hidden;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-main {
    display: flex;
    align-items: stretch;
    justify-content: center;
    background: {{ section.settings.look_image_background }};
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-main-image-wrap {
    width: 100%;
    height: 100%;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-products {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 88px 48px 72px;
    overflow: hidden;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-heading {
    margin: 0 0 90px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 400;
    color: var(--cj-text);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-slider-shell {
    position: relative;
    width: 100%;
    max-width: 520px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-slider {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-slider::-webkit-scrollbar {
    display: none;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    opacity: .45;
    transform: scale(.94);
    transition:
      opacity .7s cubic-bezier(.16, 1, .3, 1),
      transform .7s cubic-bezier(.16, 1, .3, 1);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-product-image-wrap {
    width: min(280px, 76%);
    margin: 0 auto;
    background: var(--cj-card-bg);
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-product-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 1s cubic-bezier(.16, 1, .3, 1);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-slide:hover .cj-look-product-image {
    transform: scale(1.025);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-product-info {
    margin-top: 34px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-product-info h3 {
    margin: 0 0 8px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--cj-text);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-product-info p {
    margin: 0;
    font-size: 15px;
    color: var(--cj-accent);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-arrow {
    position: absolute;
    top: 39%;
    transform: translateY(-50%);
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 0;
    background: #fff;
    color: var(--cj-text);
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
    transition:
      transform .35s ease,
      opacity .35s ease,
      background .35s ease;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-arrow:hover {
    transform: translateY(-50%) scale(1.06);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-prev {
    left: -22px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-next {
    right: -22px;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-all {
    display: inline-block;
    margin-top: 72px;
    padding: 12px 30px;
    border: 1px solid rgba(42, 24, 16, .22);
    text-decoration: none;
    font-size: 14px;
    color: var(--cj-text);
    transition:
      background .35s ease,
      color .35s ease,
      border-color .35s ease;
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-look-all:hover {
    background: var(--cj-text);
    color: #fff;
    border-color: var(--cj-text);
  }

  #CasaJunoLookCollections-{{ section.id }} .cj-placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: #f3eee8;
  }

  @media screen and (max-width: 989px) {
    #CasaJunoLookCollections-{{ section.id }} .cj-collection-grid {
      gap: 22px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-area {
      grid-template-columns: 1fr;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-main {
      min-height: 620px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-products {
      padding: 58px 24px 64px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-heading {
      margin-bottom: 56px;
    }
  }

  @media screen and (max-width: 749px) {
    #CasaJunoLookCollections-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-lc-inner {
      width: min(100% - 28px, var(--cj-max));
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-collection-grid {
      grid-template-columns: 1fr;
      gap: 46px;
      margin-bottom: {{ section.settings.space_between_sections_mobile }}px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-collection-content {
      padding-top: 20px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-collection-title {
      font-size: 23px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-main {
      min-height: 560px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-products {
      padding: 48px 18px 54px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-heading {
      font-size: 25px;
      margin-bottom: 44px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-slider-shell {
      max-width: 100%;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-arrow {
      width: 38px;
      height: 38px;
      font-size: 24px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-prev {
      left: 4px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-next {
      right: 4px;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-product-image-wrap {
      width: 72%;
    }

    #CasaJunoLookCollections-{{ section.id }} .cj-look-all {
      margin-top: 48px;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#CasaJunoLookCollections-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('[data-cj-look-slider]');
    if (!slider) return;

    const slides = Array.from(slider.querySelectorAll('.cj-look-slide'));
    const prev = section.querySelector('.cj-look-prev');
    const next = section.querySelector('.cj-look-next');

    let activeIndex = 0;
    let ticking = false;

    function setActiveSlide() {
      if (!slides.length) return;

      const sliderRect = slider.getBoundingClientRect();
      const sliderCenter = sliderRect.left + sliderRect.width / 2;

      let closestIndex = 0;
      let closestDistance = Infinity;

      slides.forEach((slide, index) => {
        const rect = slide.getBoundingClientRect();
        const center = rect.left + rect.width / 2;
        const distance = Math.abs(sliderCenter - center);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      activeIndex = closestIndex;

      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === activeIndex);
      });
    }

    function scrollToSlide(index) {
      if (!slides.length) return;

      const safeIndex = Math.max(0, Math.min(index, slides.length - 1));
      const slide = slides[safeIndex];

      slider.scrollTo({
        left: slide.offsetLeft - slider.offsetLeft,
        behavior: 'smooth'
      });

      activeIndex = safeIndex;

      setTimeout(setActiveSlide, 350);
      setTimeout(setActiveSlide, 700);
    }

    if (prev) {
      prev.addEventListener('click', () => {
        scrollToSlide(activeIndex - 1);
      });
    }

    if (next) {
      next.addEventListener('click', () => {
        scrollToSlide(activeIndex + 1);
      });
    }

    slider.addEventListener('scroll', () => {
      if (ticking) return;

      ticking = true;

      window.requestAnimationFrame(() => {
        setActiveSlide();
        ticking = false;
      });
    });

    window.addEventListener('resize', setActiveSlide);

    setActiveSlide();

    document.addEventListener('shopify:section:load', setActiveSlide);
  })();
</script>

