{%- comment -%}
  Footer Casa Junno / Estilo LP Classic — versão refinada
  Ajustes desta versão:
    · Colunas de menu adaptativas (conta os menus com links e alinha à direita) — sem espaço morto
    · Colunas sem menu não renderizam (removidos placeholders de exemplo)
    · Barra inferior alinhada "no esquadro": logo com altura limitada, laterais no mesmo eixo
    · Hierarquia refinada: títulos de menu como rótulos em caixa-alta com tracking
    · Foco visível, prefers-reduced-motion e escala tipográfica consistente
    · Mobile mantém o acordeão nativo (details/summary)
{%- endcomment -%}

{%- liquid
  assign menu_count = 0
  for block in section.blocks
    if block.settings.menu != blank
      assign menu_count = menu_count | plus: 1
    endif
  endfor
  assign menu_cols = menu_count
  if menu_cols < 1
    assign menu_cols = 1
  endif
-%}

<style>
  #cj-lp-footer-{{ section.id }} {
    --bg-page: {{ section.settings.page_bg }};
    --bg-box: {{ section.settings.box_bg }};
    --text-box: {{ section.settings.text_color }};
    --text-bottom: {{ section.settings.bottom_color }};
    --line-color: {{ section.settings.text_color | color_modify: 'alpha', 0.35 }};
    --line-strong: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
    --font-serif: Georgia, "Times New Roman", serif;

    background-color: var(--bg-page);
    padding: {{ section.settings.padding_top_desktop }}px 0 {{ section.settings.padding_bottom_desktop }}px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  #cj-lp-footer-{{ section.id }} * { box-sizing: border-box; }

  /* --- CAIXA PRINCIPAL --- */
  #cj-lp-footer-{{ section.id }} .cj-lpf-box {
    width: min({{ section.settings.box_width }}px, calc(100% - 32px));
    margin: 0 auto;
    background-color: var(--bg-box);
    color: var(--text-box);
    padding: 72px 72px 80px;
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto;
    gap: clamp(48px, 6vw, 96px);
    align-items: start;
  }

  /* --- NEWSLETTER --- */
  #cj-lp-footer-{{ section.id }} .cj-lpf-newsletter { max-width: 460px; }

  #cj-lp-footer-{{ section.id }} .cj-lpf-news-title {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--text-box);
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-news-desc {
    margin: 0 0 36px;
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-box);
    opacity: 0.9;
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-form {
    margin: 0 0 16px;
    border-bottom: 1px solid var(--line-color);
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 10px;
    transition: border-color 0.3s ease;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-form:focus-within { border-bottom-color: var(--line-strong); }

  #cj-lp-footer-{{ section.id }} .cj-lpf-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-box);
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.4;
    padding: 0;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-input::placeholder { color: var(--text-box); opacity: 0.7; }

  #cj-lp-footer-{{ section.id }} .cj-lpf-submit {
    flex: 0 0 auto;
    background: transparent;
    border: none;
    color: var(--text-box);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(.16,1,.3,1);
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-submit:hover { transform: translateX(4px); }
  #cj-lp-footer-{{ section.id }} .cj-lpf-submit svg { width: 22px; height: 14px; display: block; }

  #cj-lp-footer-{{ section.id }} .cj-lpf-news-legal {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.75;
  }

  /* --- MENUS (adaptativos, encostados à direita) --- */
  #cj-lp-footer-{{ section.id }} .cj-lpf-menus {
    display: grid;
    grid-template-columns: repeat({{ menu_cols }}, minmax(0, 170px));
    gap: clamp(36px, 4vw, 64px);
    justify-content: end;
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col details { width: 100%; }

  #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col summary {
    list-style: none;
    margin: 0 0 22px;
    font-family: var(--font-serif);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-box);
    opacity: 0.65;
    cursor: default;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col summary::-webkit-details-marker { display: none; }
  #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col .summary-icon { display: none; }

  #cj-lp-footer-{{ section.id }} .cj-lpf-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-link {
    text-decoration: none;
    color: var(--text-box);
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.4;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-link:hover { opacity: 0.55; }

  /* --- ÁREA INFERIOR --- */
  #cj-lp-footer-{{ section.id }} .cj-lpf-bottom {
    width: min({{ section.settings.box_width }}px, calc(100% - 32px));
    margin: 56px auto 0;
    padding-inline: clamp(16px, 2.4vw, 36px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px 32px;
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-locale {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1;
    color: var(--text-bottom);
    justify-self: start;
    opacity: 0.8;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-locale svg {
    width: 15px; height: 15px; flex: 0 0 auto;
    fill: none; stroke: currentColor; stroke-width: 1.2;
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-logo {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-logo img {
    max-width: {{ section.settings.logo_width }}px;
    max-height: 52px;
    width: auto;
    height: auto;
    display: block;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-logo-text {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1;
    font-style: italic;
    color: var(--text-bottom);
  }

  #cj-lp-footer-{{ section.id }} .cj-lpf-socials {
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-social-link {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 13px;
    color: var(--text-bottom);
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  #cj-lp-footer-{{ section.id }} .cj-lpf-social-link:hover { opacity: 1; }

  #cj-lp-footer-{{ section.id }} .cj-lpf-copyright {
    text-align: center;
    margin-top: 44px;
    font-family: var(--font-serif);
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-bottom);
    opacity: 0.5;
  }

  /* --- FOCO VISÍVEL --- */
  #cj-lp-footer-{{ section.id }} a:focus-visible,
  #cj-lp-footer-{{ section.id }} button:focus-visible,
  #cj-lp-footer-{{ section.id }} summary:focus-visible,
  #cj-lp-footer-{{ section.id }} input:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  /* --- RESPONSIVO --- */
  @media screen and (max-width: 1024px) {
    #cj-lp-footer-{{ section.id }} .cj-lpf-box { padding: 56px 40px; }
    #cj-lp-footer-{{ section.id }} .cj-lpf-grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    #cj-lp-footer-{{ section.id }} .cj-lpf-newsletter { max-width: 520px; }
    #cj-lp-footer-{{ section.id }} .cj-lpf-menus {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      justify-content: start;
      gap: 48px 40px;
    }
  }

  @media screen and (max-width: 768px) {
    #cj-lp-footer-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
    #cj-lp-footer-{{ section.id }} .cj-lpf-box { padding: 40px 24px; }
    #cj-lp-footer-{{ section.id }} .cj-lpf-grid { gap: 0; }
    #cj-lp-footer-{{ section.id }} .cj-lpf-newsletter { margin-bottom: 40px; max-width: none; }

    #cj-lp-footer-{{ section.id }} .cj-lpf-menus {
      display: block;
    }
    #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col { border-top: 1px solid var(--line-color); }
    #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col:last-child { border-bottom: 1px solid var(--line-color); }

    #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col summary {
      margin: 0;
      padding: 22px 0;
      cursor: pointer;
      opacity: 0.85;
    }
    #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col .summary-icon {
      display: block;
      font-size: 20px;
      font-weight: 300;
      opacity: 0.7;
      transition: transform 0.3s ease;
    }
    #cj-lp-footer-{{ section.id }} .cj-lpf-menu-col details[open] .summary-icon { transform: rotate(45deg); }
    #cj-lp-footer-{{ section.id }} .cj-lpf-links { padding-bottom: 24px; }

    #cj-lp-footer-{{ section.id }} .cj-lpf-bottom {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 36px;
      margin-top: 48px;
      padding-inline: 0;
    }
    #cj-lp-footer-{{ section.id }} .cj-lpf-locale,
    #cj-lp-footer-{{ section.id }} .cj-lpf-socials { justify-self: center; justify-content: center; }
    #cj-lp-footer-{{ section.id }} .cj-lpf-logo img { max-height: 44px; max-width: {{ section.settings.logo_width_mobile }}px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #cj-lp-footer-{{ section.id }} * { transition: none !important; }
  }
</style>

<footer id="cj-lp-footer-{{ section.id }}">

  <div class="cj-lpf-box">
    <div class="cj-lpf-grid">

      <!-- Newsletter -->
      <div class="cj-lpf-newsletter">
        <h2 class="cj-lpf-news-title">{{ section.settings.newsletter_title }}</h2>
        <p class="cj-lpf-news-desc">{{ section.settings.newsletter_text }}</p>

        {%- form 'customer', class: 'cj-lpf-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input class="cj-lpf-input" type="email" name="contact[email]" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="{{ section.settings.email_placeholder }}" aria-label="{{ section.settings.email_placeholder }}" required>
          <button class="cj-lpf-submit" type="submit" aria-label="Assinar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m0 0l-6-6m6 6l-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        {%- endform -%}

        <p class="cj-lpf-news-legal">{{ section.settings.legal_text }}</p>
      </div>

      <!-- Menus (só renderiza colunas com links) -->
      {%- if menu_count > 0 -%}
        <div class="cj-lpf-menus">
          {%- for block in section.blocks -%}
            {%- if block.settings.menu != blank -%}
              <div class="cj-lpf-menu-col" {{ block.shopify_attributes }}>
                <details class="cj-lpf-details" open>
                  <summary>
                    {{ block.settings.title }}
                    <span class="summary-icon" aria-hidden="true">+</span>
                  </summary>
                  <ul class="cj-lpf-links">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li><a class="cj-lpf-link" href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>

  <div class="cj-lpf-bottom">

    <div class="cj-lpf-locale">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
      {{ section.settings.locale_text }}
    </div>

    <a href="{{ routes.root_url }}" class="cj-lpf-logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
      {%- else -%}
        <span class="cj-lpf-logo-text">{{ section.settings.logo_text }}</span>
      {%- endif -%}
    </a>

    {%- liquid
      assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link
    -%}

    {%- if instagram_url != blank -%}
      <div class="cj-lpf-socials">
        {%- if instagram_url != blank -%}<a class="cj-lpf-social-link" data-gtm-event-name="social-instagram" href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>{%- endif -%}
      </div>
    {%- else -%}
      <span></span>
    {%- endif -%}

  </div>

  <div class="cj-lpf-copyright">
    {{ section.settings.copyright }}
  </div>

</footer>

<script>
  // Acordeão: aberto no desktop, colapsável no mobile.
  (function () {
    var root = document.getElementById('cj-lp-footer-{{ section.id }}');
    if (!root) return;
    var details = root.querySelectorAll('.cj-lpf-details');
    var mq = window.matchMedia('(max-width: 768px)');
    function sync() {
      details.forEach(function (d) {
        if (mq.matches) { d.removeAttribute('open'); }
        else { d.setAttribute('open', ''); }
      });
    }
    sync();
    if (mq.addEventListener) { mq.addEventListener('change', sync); }
    else if (mq.addListener) { mq.addListener(sync); }
  })();
</script>

{% schema %}
{
  "name": "Footer Casa Junno Clássic",
  "tag": "footer",
  "settings": [
    { "type": "header", "content": "Cores Principais" },
    { "type": "color", "id": "page_bg", "label": "Cor do fundo da página", "default": "#F4EEE6" },
    { "type": "color", "id": "box_bg", "label": "Cor do retângulo principal", "default": "#8D4A41" },
    { "type": "color", "id": "text_color", "label": "Cor dos textos dentro do retângulo", "default": "#FFF7EF" },
    { "type": "color", "id": "bottom_color", "label": "Cor textos e logo inferiores", "default": "#8D4A41" },

    { "type": "header", "content": "Espaçamentos e Tamanhos" },
    { "type": "range", "id": "box_width", "label": "Largura máxima do retângulo", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
    { "type": "range", "id": "padding_top_desktop", "label": "Espaço acima (Desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Espaço abaixo (Desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaço acima (Mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaço abaixo (Mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "logo_width", "label": "Largura máx. da logo (Desktop)", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "logo_width_mobile", "label": "Largura máx. da logo (Mobile)", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 120 },

    { "type": "header", "content": "Conteúdo" },
    { "type": "text", "id": "newsletter_title", "label": "Título newsletter", "default": "Assine nossa newsletter" },
    { "type": "textarea", "id": "newsletter_text", "label": "Texto newsletter", "default": "Receba nossa newsletter e descubra nosso universo, coleções e as últimas novidades." },
    { "type": "text", "id": "email_placeholder", "label": "Placeholder e-mail", "default": "Seu endereço de e-mail" },
    { "type": "textarea", "id": "legal_text", "label": "Texto legal abaixo do e-mail", "default": "Reconheço que meu e-mail será processado pela Casa Junno conforme a Política de Privacidade." },
    { "type": "text", "id": "locale_text", "label": "Texto idioma/país", "default": "BRASIL (PT-BR)" },
    { "type": "image_picker", "id": "logo_image", "label": "Imagem da Marca Inferior" },
    { "type": "text", "id": "logo_text", "label": "Texto da logo caso não envie imagem", "default": "Casa Junno" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "Casa Junno 2026. Todos os direitos reservados." },

    { "type": "header", "content": "Redes Sociais" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn URL" },
    { "type": "url", "id": "wechat_url", "label": "Wechat URL" },
    { "type": "url", "id": "weibo_url", "label": "Weibo URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Coluna de menu",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Contato" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Casa Junno Clássico",
      "blocks": [
        { "type": "menu", "settings": { "title": "Contato" } },
        { "type": "menu", "settings": { "title": "A Empresa" } },
        { "type": "menu", "settings": { "title": "Serviços" } },
        { "type": "menu", "settings": { "title": "Legal & Cookies" } }
      ]
    }
  ]
}
{% endschema %}