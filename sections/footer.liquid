{%- comment -%}
  Footer Casa Juno / Estilo Quiet Luxury
  - Bloco principal com cor editável e respiro elegante
  - Hierarquia tipográfica refinada (serifa + uppercase)
  - Redes sociais e logo centralizadas
  - Mobile empilhado e centralizado com transições suaves
{%- endcomment -%}

<style>
  #cj-footer-{{ section.id }} {
    --cj-footer-bg: {{ section.settings.box_bg }};
    --cj-footer-text: {{ section.settings.text_color }};
    --cj-footer-muted: {{ section.settings.muted_color }};
    --cj-footer-line: {{ section.settings.text_color | color_modify: 'alpha', 0.25 }};
    --cj-footer-placeholder: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    --cj-footer-page-bg: {{ section.settings.page_bg }};
    
    background: var(--cj-footer-page-bg);
    color: var(--cj-footer-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: Georgia, 'Times New Roman', serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  #cj-footer-{{ section.id }} .cj-footer__box {
    width: min({{ section.settings.box_width }}px, calc(100% - 64px));
    margin: 0 auto;
    background: var(--cj-footer-bg);
    color: var(--cj-footer-text);
    padding: 80px 100px;
  }

  #cj-footer-{{ section.id }} .cj-footer__grid {
    display: grid;
    grid-template-columns: minmax(320px, 1.4fr) repeat(4, minmax(120px, .8fr));
    gap: 64px;
    align-items: start;
  }

  #cj-footer-{{ section.id }} .cj-footer__newsletter-title {
    margin: 0 0 16px;
    color: var(--cj-footer-text);
    font-weight: 300;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  #cj-footer-{{ section.id }} .cj-footer__heading {
    margin: 0 0 24px;
    color: var(--cj-footer-text);
    font-size: 11px;
    font-weight: 600;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  #cj-footer-{{ section.id }} .cj-footer__text,
  #cj-footer-{{ section.id }} .cj-footer__legal,
  #cj-footer-{{ section.id }} .cj-footer__link,
  #cj-footer-{{ section.id }} .cj-footer__bottom-link,
  #cj-footer-{{ section.id }} .cj-footer__locale {
    font-family: Georgia, 'Times New Roman', serif;
    color: var(--cj-footer-text);
    font-size: 14px;
    line-height: 1.6;
    font-weight: 400;
  }

  #cj-footer-{{ section.id }} .cj-footer__text {
    max-width: 380px;
    margin: 0 0 40px;
    opacity: 0.85;
  }

  #cj-footer-{{ section.id }} .cj-footer__form {
    max-width: 420px;
    margin: 0 0 24px;
    border-bottom: 1px solid var(--cj-footer-line);
    display: grid;
    grid-template-columns: 1fr 34px;
    align-items: center;
    transition: border-color 0.4s ease;
  }

  #cj-footer-{{ section.id }} .cj-footer__form:focus-within {
    border-bottom-color: var(--cj-footer-text);
  }

  #cj-footer-{{ section.id }} .cj-footer__input {
    width: 100%;
    min-height: 46px;
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: var(--cj-footer-text);
    font-size: 14px;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
  }

  #cj-footer-{{ section.id }} .cj-footer__input::placeholder {
    color: var(--cj-footer-placeholder);
    opacity: 1;
  }

  #cj-footer-{{ section.id }} .cj-footer__submit {
    width: 34px;
    height: 46px;
    border: 0;
    background: transparent;
    color: var(--cj-footer-text);
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  #cj-footer-{{ section.id }} .cj-footer__submit:hover {
    transform: translateX(4px);
    opacity: 0.7;
  }

  #cj-footer-{{ section.id }} .cj-footer__legal {
    max-width: 430px;
    margin: 0;
    font-size: 11px;
    opacity: 0.6;
    line-height: 1.5;
  }

  #cj-footer-{{ section.id }} .cj-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  #cj-footer-{{ section.id }} .cj-footer__link,
  #cj-footer-{{ section.id }} .cj-footer__bottom-link {
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.4s ease;
    display: inline-block;
  }

  #cj-footer-{{ section.id }} .cj-footer__link:hover,
  #cj-footer-{{ section.id }} .cj-footer__bottom-link:hover {
    opacity: 0.5;
  }

  #cj-footer-{{ section.id }} .cj-footer__bottom {
    width: min({{ section.settings.box_width }}px, calc(100% - 64px));
    margin: 64px auto 0;
    background: {{ section.settings.bottom_area_bg }};
    padding: {{ section.settings.bottom_area_padding }}px 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    color: {{ section.settings.bottom_color }};
  }

  #cj-footer-{{ section.id }} .cj-footer__locale,
  #cj-footer-{{ section.id }} .cj-footer__bottom-link,
  #cj-footer-{{ section.id }} .cj-footer__copyright {
    color: {{ section.settings.bottom_color }};
    font-family: Georgia, 'Times New Roman', serif;
  }

  #cj-footer-{{ section.id }} .cj-footer__locale {
    font-size: 12px;
    letter-spacing: 0.02em;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    opacity: 0.8;
  }

  #cj-footer-{{ section.id }} .cj-footer__brand-social {
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 64px;
    white-space: nowrap;
  }

  #cj-footer-{{ section.id }} .cj-footer__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: {{ section.settings.bottom_color }};
    transition: opacity 0.4s ease;
  }

  #cj-footer-{{ section.id }} .cj-footer__logo-link:hover {
    opacity: 0.8;
  }

  #cj-footer-{{ section.id }} .cj-footer__logo-img {
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  #cj-footer-{{ section.id }} .cj-footer__logo-text {
    color: {{ section.settings.bottom_color }};
    font-size: 24px;
    font-style: italic;
    letter-spacing: 0.04em;
  }

  #cj-footer-{{ section.id }} .cj-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: center;
    align-items: center;
  }

  #cj-footer-{{ section.id }} .cj-footer__bottom-link { 
    font-size: 13px;
    font-style: italic; 
  }

  #cj-footer-{{ section.id }} .cj-footer__copyright {
    width: min({{ section.settings.box_width }}px, calc(100% - 64px));
    margin: 32px auto 0;
    text-align: center;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.4;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  @media (max-width: 1024px) {
    #cj-footer-{{ section.id }} .cj-footer__box { padding: 64px 48px; }
    #cj-footer-{{ section.id }} .cj-footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 56px 40px;
    }
    #cj-footer-{{ section.id }} .cj-footer__newsletter { grid-column: 1 / -1; }
    #cj-footer-{{ section.id }} .cj-footer__bottom {
      grid-template-columns: 1fr;
      text-align: center;
    }
    #cj-footer-{{ section.id }} .cj-footer__locale,
    #cj-footer-{{ section.id }} .cj-footer__brand-social { justify-self: center; }
  }

  @media (max-width: 767px) {
    #cj-footer-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }
    #cj-footer-{{ section.id }} .cj-footer__box {
      width: calc(100% - 32px);
      padding: 48px 32px;
    }
    #cj-footer-{{ section.id }} .cj-footer__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    #cj-footer-{{ section.id }} .cj-footer__newsletter-title {
      font-size: 26px;
      margin-bottom: 12px;
    }
    #cj-footer-{{ section.id }} .cj-footer__text {
      margin-bottom: 32px;
    }
    #cj-footer-{{ section.id }} .cj-footer__links { gap: 16px; }
    #cj-footer-{{ section.id }} .cj-footer__bottom {
      width: calc(100% - 32px);
      margin-top: 48px;
      padding: {{ section.settings.bottom_area_padding_mobile }}px 0;
      grid-template-columns: 1fr;
      text-align: center;
      gap: 32px;
    }
    #cj-footer-{{ section.id }} .cj-footer__brand-social {
      flex-direction: column;
      gap: 32px;
    }
    #cj-footer-{{ section.id }} .cj-footer__logo-img {
      width: {{ section.settings.logo_width_mobile }}px;
    }
    #cj-footer-{{ section.id }} .cj-footer__social { gap: 16px 24px; }
    #cj-footer-{{ section.id }} .cj-footer__copyright {
      width: calc(100% - 32px);
      line-height: 1.6;
      margin-top: 40px;
    }
  }
</style>

<footer id="cj-footer-{{ section.id }}" class="cj-footer">
  <div class="cj-footer__box">
    <div class="cj-footer__grid">
      <div class="cj-footer__newsletter">
        <h2 class="cj-footer__newsletter-title">{{ section.settings.newsletter_title }}</h2>
        <p class="cj-footer__text">{{ section.settings.newsletter_text }}</p>

        {%- form 'customer', class: 'cj-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input class="cj-footer__input" type="email" name="contact[email]" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="{{ section.settings.email_placeholder }}" required>
          <button class="cj-footer__submit" type="submit" aria-label="Subscribe">⟶</button>
        {%- endform -%}

        <p class="cj-footer__legal">{{ section.settings.legal_text }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="cj-footer__column" {{ block.shopify_attributes }}>
              <h3 class="cj-footer__heading">{{ block.settings.title }}</h3>
              <ul class="cj-footer__links">
                {%- if block.settings.menu != blank -%}
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a class="cj-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  <li><a class="cj-footer__link" href="/pages/contact">Contacts</a></li>
                  <li><a class="cj-footer__link" href="/pages/faq">FAQ</a></li>
                {%- endif -%}
              </ul>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="cj-footer__bottom">
    <div class="cj-footer__locale">◎ {{ section.settings.locale_text }}</div>

    <div class="cj-footer__brand-social">
      <a class="cj-footer__logo-link" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if section.settings.logo_image != blank -%}
          {{ section.settings.logo_image | image_url: width: 520 | image_tag: class: 'cj-footer__logo-img', loading: 'lazy', alt: shop.name }}
        {%- else -%}
          <span class="cj-footer__logo-text">{{ section.settings.logo_text }}</span>
        {%- endif -%}
      </a>

      <div class="cj-footer__social">
        {%- if section.settings.instagram_url != blank -%}<a class="cj-footer__bottom-link" href="{{ section.settings.instagram_url }}">Instagram</a>{%- endif -%}
        {%- if section.settings.facebook_url != blank -%}<a class="cj-footer__bottom-link" href="{{ section.settings.facebook_url }}">Facebook</a>{%- endif -%}
        {%- if section.settings.linkedin_url != blank -%}<a class="cj-footer__bottom-link" href="{{ section.settings.linkedin_url }}">LinkedIn</a>{%- endif -%}
        {%- if section.settings.wechat_url != blank -%}<a class="cj-footer__bottom-link" href="{{ section.settings.wechat_url }}">Wechat</a>{%- endif -%}
        {%- if section.settings.weibo_url != blank -%}<a class="cj-footer__bottom-link" href="{{ section.settings.weibo_url }}">Weibo</a>{%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}<a class="cj-footer__bottom-link" href="{{ section.settings.tiktok_url }}">TikTok</a>{%- endif -%}
      </div>
    </div>

    <div></div>
  </div>

  <div class="cj-footer__copyright">{{ section.settings.copyright }}</div>
</footer>

{% schema %}
{
  "name": "Footer Casa Juno",
  "settings": [
    { "type": "color", "id": "page_bg", "label": "Cor do fundo da página", "default": "#F4EEE6" },
    { "type": "color", "id": "box_bg", "label": "Cor do retângulo principal", "default": "#A4554B" },
    { "type": "color", "id": "text_color", "label": "Cor dos textos do retângulo", "default": "#FFF7EF" },
    { "type": "color", "id": "muted_color", "label": "Cor secundária", "default": "#F4D8CF" },
    { "type": "color", "id": "bottom_color", "label": "Cor textos inferiores", "default": "#A4554B" },
    { "type": "color", "id": "bottom_area_bg", "label": "Cor do fundo da área da logo/redes", "default": "#F4EEE6" },
    { "type": "range", "id": "box_width", "label": "Largura máxima do retângulo", "min": 960, "max": 1600, "step": 16, "unit": "px", "default": 1280 },
    { "type": "range", "id": "padding_top", "label": "Espaço superior desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espaço inferior desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espaço superior mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espaço inferior mobile", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "bottom_area_padding", "label": "Altura/espacamento da área logo desktop", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "bottom_area_padding_mobile", "label": "Altura/espacamento da área logo mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 8 },
    { "type": "text", "id": "newsletter_title", "label": "Título newsletter", "default": "Subscribe to our newsletter" },
    { "type": "textarea", "id": "newsletter_text", "label": "Texto newsletter", "default": "Receive our newsletter and discover our world, collections, and latest news from us." },
    { "type": "text", "id": "email_placeholder", "label": "Placeholder e-mail", "default": "Your email address" },
    { "type": "textarea", "id": "legal_text", "label": "Texto legal abaixo do e-mail", "default": "I acknowledge that my email address will be processed in accordance with the provisions of the Privacy Policy." },
    { "type": "text", "id": "locale_text", "label": "Texto idioma/país", "default": "INTL (English)" },
    { "type": "image_picker", "id": "logo_image", "label": "Imagem/logo inferior" },
    { "type": "text", "id": "logo_text", "label": "Texto da logo caso não envie imagem", "default": "Casa Juno" },
    { "type": "range", "id": "logo_width", "label": "Largura da logo desktop", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 140 },
    { "type": "range", "id": "logo_width_mobile", "label": "Largura da logo mobile", "min": 60, "max": 220, "step": 10, "unit": "px", "default": 120 },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "Casa Juno 2026 | All rights reserved" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn URL" },
    { "type": "url", "id": "wechat_url", "label": "Wechat URL" },
    { "type": "url", "id": "weibo_url", "label": "Weibo URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Coluna de menu",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Company" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Casa Juno",
      "blocks": [
        { "type": "menu", "settings": { "title": "Get in touch" } },
        { "type": "menu", "settings": { "title": "Company" } },
        { "type": "menu", "settings": { "title": "Services" } },
        { "type": "menu", "settings": { "title": "Legal & Cookies" } }
      ]
    }
  ]
}
{% endschema %}