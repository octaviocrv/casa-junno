{% comment %}
  Casa Juno PDP Image Grid
  Path: sections/cj-pdp-image-grid.liquid

  Como usar:
  1. Crie este arquivo em Online Store > Themes > Edit code > Sections.
  2. Nome do arquivo: cj-pdp-image-grid.liquid
  3. No editor do tema, adicione a section "Casa Juno PDP Image Grid" abaixo da section da PDP.
  4. Para imagens individuais por produto, conecte cada campo de imagem a um metafield do produto usando o ícone de fonte dinâmica.

  Metafields sugeridos:
  custom.pdp_grid_image_1
  custom.pdp_grid_image_2
  custom.pdp_grid_image_3
  custom.pdp_grid_image_4
{% endcomment %}

{% liquid
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_3 = section.settings.image_3
  assign image_4 = section.settings.image_4

  assign image_count = 0
  if image_1 != blank
    assign image_count = image_count | plus: 1
  endif
  if image_2 != blank
    assign image_count = image_count | plus: 1
  endif
  if image_3 != blank
    assign image_count = image_count | plus: 1
  endif
  if image_4 != blank
    assign image_count = image_count | plus: 1
  endif
%}

{% if image_count > 0 or request.design_mode %}
  <section
    id="CasaJunoImageGrid-{{ section.id }}"
    class="cj-image-grid-section"
    data-section-id="{{ section.id }}"
  >
    <style>
      #CasaJunoImageGrid-{{ section.id }} {
        --cj-grid-bg: {{ section.settings.background_color }};
        --cj-grid-card-bg: {{ section.settings.card_background }};
        --cj-grid-text: {{ section.settings.text_color }};
        --cj-grid-muted: {{ section.settings.muted_color }};
        --cj-grid-border: {{ section.settings.border_color }};
        --cj-grid-max-width: {{ section.settings.max_width }}px;
        --cj-grid-gap: {{ section.settings.grid_gap }}px;
        --cj-grid-radius: {{ section.settings.image_radius }}px;
        --cj-grid-padding-top: {{ section.settings.padding_top }}px;
        --cj-grid-padding-bottom: {{ section.settings.padding_bottom }}px;
        --cj-grid-mobile-padding-top: {{ section.settings.padding_top_mobile }}px;
        --cj-grid-mobile-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        background: var(--cj-grid-bg);
        color: var(--cj-grid-text);
        width: 100%;
      }

      #CasaJunoImageGrid-{{ section.id }} *,
      #CasaJunoImageGrid-{{ section.id }} *::before,
      #CasaJunoImageGrid-{{ section.id }} *::after {
        box-sizing: border-box;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__shell {
        width: 100%;
        max-width: var(--cj-grid-max-width);
        margin: 0 auto;
        padding: var(--cj-grid-padding-top) 42px var(--cj-grid-padding-bottom);
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__head {
        max-width: 720px;
        margin: 0 0 26px;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__eyebrow {
        margin: 0 0 10px;
        color: var(--cj-grid-muted);
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 12px;
        line-height: 1.2;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__title {
        margin: 0;
        color: var(--cj-grid-text);
        font-family: Georgia, 'Times New Roman', serif;
        font-size: clamp(30px, 3.2vw, 54px);
        line-height: 1;
        font-weight: 400;
        letter-spacing: -.035em;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__copy {
        max-width: 560px;
        margin: 14px 0 0;
        color: var(--cj-grid-muted);
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 17px;
        line-height: 1.55;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid {
        display: grid;
        gap: var(--cj-grid-gap);
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--1 {
        grid-template-columns: 1fr;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--3 .cj-image-grid__item:first-child {
        grid-row: span 2;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--4 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__item {
        position: relative;
        display: block;
        min-width: 0;
        margin: 0;
        background: var(--cj-grid-card-bg);
        border: 1px solid color-mix(in srgb, var(--cj-grid-border) 82%, transparent);
        border-radius: var(--cj-grid-radius);
        overflow: hidden;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__frame {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: {{ section.settings.image_ratio }};
        overflow: hidden;
        background: var(--cj-grid-card-bg);
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--3 .cj-image-grid__item:first-child .cj-image-grid__frame {
        height: 100%;
        aspect-ratio: auto;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: {{ section.settings.image_fit }};
        object-position: center;
        transition: transform .42s ease;
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__item:hover .cj-image-grid__img {
        transform: scale(1.025);
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__caption {
        position: absolute;
        left: 18px;
        bottom: 16px;
        max-width: calc(100% - 36px);
        padding: 8px 12px 7px;
        background: rgba(255, 253, 250, .82);
        color: var(--cj-grid-text);
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 12px;
        line-height: 1.2;
        letter-spacing: .08em;
        text-transform: uppercase;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__empty {
        padding: 28px;
        border: 1px dashed color-mix(in srgb, var(--cj-grid-border) 90%, transparent);
        background: var(--cj-grid-card-bg);
        color: var(--cj-grid-muted);
        font-size: 14px;
        line-height: 1.5;
      }

      @media (max-width: 989px) {
        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__shell {
          padding-left: 28px;
          padding-right: 28px;
        }
      }

      @media (max-width: 749px) {
        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__shell {
          padding: var(--cj-grid-mobile-padding-top) 16px var(--cj-grid-mobile-padding-bottom);
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__head {
          margin-bottom: 18px;
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__title {
          font-size: clamp(28px, 9vw, 40px);
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__copy {
          font-size: 15px;
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid,
        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--1,
        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--2,
        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--3,
        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--4 {
          grid-template-columns: repeat({% if section.settings.mobile_columns == '2' %}2{% else %}1{% endif %}, minmax(0, 1fr));
          gap: {{ section.settings.mobile_grid_gap }}px;
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--3 .cj-image-grid__item:first-child {
          grid-row: auto;
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__grid--3 .cj-image-grid__item:first-child .cj-image-grid__frame {
          aspect-ratio: {{ section.settings.image_ratio }};
        }

        #CasaJunoImageGrid-{{ section.id }} .cj-image-grid__caption {
          left: 10px;
          bottom: 10px;
          max-width: calc(100% - 20px);
          font-size: 10px;
        }
      }
    </style>

    <div class="cj-image-grid__shell">
      {% if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.copy != blank %}
        <div class="cj-image-grid__head">
          {% if section.settings.eyebrow != blank %}
            <p class="cj-image-grid__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2 class="cj-image-grid__title">{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.copy != blank %}
            <div class="cj-image-grid__copy">{{ section.settings.copy }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if image_count > 0 %}
        <div class="cj-image-grid__grid cj-image-grid__grid--{{ image_count }}">
          {% if image_1 != blank %}
            <figure class="cj-image-grid__item">
              <span class="cj-image-grid__frame">
                {{ image_1 | image_url: width: 1800 | image_tag: class: 'cj-image-grid__img', widths: '420, 640, 900, 1200, 1600, 1800', loading: 'lazy', alt: section.settings.caption_1 | default: product.title | escape }}
              </span>
              {% if section.settings.caption_1 != blank %}<figcaption class="cj-image-grid__caption">{{ section.settings.caption_1 }}</figcaption>{% endif %}
            </figure>
          {% endif %}

          {% if image_2 != blank %}
            <figure class="cj-image-grid__item">
              <span class="cj-image-grid__frame">
                {{ image_2 | image_url: width: 1800 | image_tag: class: 'cj-image-grid__img', widths: '420, 640, 900, 1200, 1600, 1800', loading: 'lazy', alt: section.settings.caption_2 | default: product.title | escape }}
              </span>
              {% if section.settings.caption_2 != blank %}<figcaption class="cj-image-grid__caption">{{ section.settings.caption_2 }}</figcaption>{% endif %}
            </figure>
          {% endif %}

          {% if image_3 != blank %}
            <figure class="cj-image-grid__item">
              <span class="cj-image-grid__frame">
                {{ image_3 | image_url: width: 1800 | image_tag: class: 'cj-image-grid__img', widths: '420, 640, 900, 1200, 1600, 1800', loading: 'lazy', alt: section.settings.caption_3 | default: product.title | escape }}
              </span>
              {% if section.settings.caption_3 != blank %}<figcaption class="cj-image-grid__caption">{{ section.settings.caption_3 }}</figcaption>{% endif %}
            </figure>
          {% endif %}

          {% if image_4 != blank %}
            <figure class="cj-image-grid__item">
              <span class="cj-image-grid__frame">
                {{ image_4 | image_url: width: 1800 | image_tag: class: 'cj-image-grid__img', widths: '420, 640, 900, 1200, 1600, 1800', loading: 'lazy', alt: section.settings.caption_4 | default: product.title | escape }}
              </span>
              {% if section.settings.caption_4 != blank %}<figcaption class="cj-image-grid__caption">{{ section.settings.caption_4 }}</figcaption>{% endif %}
            </figure>
          {% endif %}
        </div>
      {% elsif request.design_mode %}
        <div class="cj-image-grid__empty">
          Adicione imagens nos campos da seção ou conecte cada campo a um metafield do produto usando a fonte dinâmica. Assim cada produto pode ter seu próprio grid.
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Casa Juno PDP Image Grid",
  "tag": "section",
  "class": "section-cj-pdp-image-grid",
  "settings": [
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto pequeno acima do título",
      "default": "Detalhes da peça"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Caimento, textura e acabamento"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Texto",
      "default": "<p>Uma seleção visual para mostrar tecido, acabamento e presença da peça em detalhes.</p>"
    },
    {
      "type": "header",
      "content": "Imagens do grid"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Imagem 1"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Legenda da imagem 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Imagem 2"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Legenda da imagem 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Imagem 3"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Legenda da imagem 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Imagem 4"
    },
    {
      "type": "text",
      "id": "caption_4",
      "label": "Legenda da imagem 4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largura máxima",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporção das imagens",
      "options": [
        { "value": "1 / 1", "label": "Quadrada" },
        { "value": "4 / 5", "label": "Editorial vertical" },
        { "value": "3 / 4", "label": "Vertical" },
        { "value": "16 / 10", "label": "Horizontal" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Encaixe da imagem",
      "options": [
        { "value": "cover", "label": "Preencher/cortar" },
        { "value": "contain", "label": "Mostrar inteira" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Espaço entre imagens no desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Colunas no mobile",
      "options": [
        { "value": "1", "label": "1 coluna" },
        { "value": "2", "label": "2 colunas" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "label": "Espaço entre imagens no mobile",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arredondamento das imagens",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço acima no desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço abaixo no desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Espaço acima no mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Espaço abaixo no mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fundo da seção",
      "default": "#f6f1ed"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fundo das imagens",
      "default": "#f8f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto principal",
      "default": "#2f2421"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texto secundário",
      "default": "#7d7068"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordas",
      "default": "#d9cbc1"
    }
  ],
  "presets": [
    {
      "name": "Casa Juno PDP Image Grid"
    }
  ]
}
{% endschema %}
