# Shopify Configuration
# Copy this file to .env and fill with your actual values
# DO NOT commit .env to git!

# Seu store no Shopify (ex: casa-junno.myshopify.com)
SHOPIFY_STORE_NAME=sua-loja.myshopify.com

# Token de acesso da API do Shopify
# Gere em: Admin → Configurações → Apps and integrations → App and sales channel settings
SHOPIFY_ACCESS_TOKEN=seu_token_aqui
